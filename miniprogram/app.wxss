/* ==================== 背景颜色 ==================== */

.bg-white {
  background-color: #ffffff;
}

.bg-gray {
  background-color: #f5f5f5;
}

.bg-primary {
  background-color: #4a90e2;
}

.bg-primary-light {
  background-color: rgba(74, 144, 226, 0.1);
}

.bg-success {
  background-color: #52c41a;
}

.bg-warning {
  background-color: #faad14;
}

.bg-danger {
  background-color: #ff4d4f;
}

/* ==================== 圆角样式 ==================== */

.rounded-none {
  border-radius: 0;
}

.rounded-sm {
  border-radius: 8rpx;
}

.rounded {
  border-radius: 12rpx;
}

.rounded-lg {
  border-radius: 16rpx;
}

.rounded-xl {
  border-radius: 24rpx;
}

.rounded-full {
  border-radius: 50%;
}

/* ==================== 边框样式 ==================== */

.border {
  border: 1rpx solid #eeeeee;
}

.border-top {
  border-top: 1rpx solid #eeeeee;
}

.border-bottom {
  border-bottom: 1rpx solid #eeeeee;
}

.border-primary {
  border-color: #4a90e2;
}

/* ==================== 阴影样式 ==================== */

.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.shadow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.shadow-lg {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* ==================== 通用组件样式 ==================== */

/* 容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
}

/* 卡片 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #eeeeee;
  margin: 20rpx 0;
}

/* 按钮样式 */
.btn {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #ffffff;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-outline {
  background-color: transparent;
  border: 2rpx solid #4a90e2;
  color: #4a90e2;
}

.btn-outline:active {
  background-color: rgba(74, 144, 226, 0.1);
}

.btn-gray {
  background-color: #f5f5f5;
  color: #666666;
}

.btn-disabled {
  background-color: #cccccc;
  color: #ffffff;
}

.btn-small {
  height: 60rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 6rpx;
  background-color: rgba(74, 144, 226, 0.1);
  color: #4a90e2;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-primary {
  background-color: #4a90e2;
  color: #ffffff;
}

.tag-success {
  background-color: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.tag-warning {
  background-color: rgba(250, 173, 20, 0.1);
  color: #faad14;
}

.tag-danger {
  background-color: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

/* 头像样式 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #eeeeee;
}

.avatar-sm {
  width: 60rpx;
  height: 60rpx;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
}

.avatar-xl {
  width: 160rpx;
  height: 160rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 50rpx;
}

.empty-state .empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-state .empty-text {
  font-size: 30rpx;
  color: #999999;
  margin-bottom: 10rpx;
}

.empty-state .empty-tip {
  font-size: 26rpx;
  color: #cccccc;
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  color: #999999;
  font-size: 26rpx;
}

.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  color: #cccccc;
  font-size: 24rpx;
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

/* 弹出层 */
.popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.popup.show {
  transform: translateY(0);
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 动画效果 ==================== */

/* 淡入动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

/* 缩放动画 */
@keyframes scaleIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.scale-in {
  animation: scaleIn 0.3s ease;
}

/* 滑入动画 */
@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.slide-up {
  animation: slideUp 0.3s ease;
}
