/* 毛玻璃效果自定义TabBar样式 */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  display: flex;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  /* 毛玻璃效果 */
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  z-index: 999;
}

/* 顶部分割线 - 使用渐变实现柔和效果 */
.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(255, 128, 102, 0.15) 20%, 
    rgba(255, 128, 102, 0.15) 80%, 
    transparent 100%
  );
}

/* 单个Tab项 */
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  position: relative;
  transition: transform 0.15s ease;
}

.tab-bar-item:active {
  transform: scale(0.92);
}

/* 图标 */
.tab-bar-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}

/* 文字 */
.tab-bar-text {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  transition: color 0.2s ease;
}

/* 未读红点 */
.unread-dot {
  position: absolute;
  top: 10rpx;
  right: 50%;
  transform: translateX(30rpx);
  width: 14rpx;
  height: 14rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(255, 128, 102, 0.4);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: translateX(30rpx) scale(1);
    opacity: 1;
  }
  50% {
    transform: translateX(30rpx) scale(1.2);
    opacity: 0.8;
  }
}

/* 选中态特效 - 底部指示条 */
.tab-bar-item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 2rpx;
}
