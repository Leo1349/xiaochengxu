/* pages/chat/index.wxss - 智伴优程聊天页柔和精致风格 */

.container {
  min-height: 100vh;
  background-color: #FFF9F5;
  display: flex;
  flex-direction: column;
}

/* ==================== 消息列表 ==================== */

.message-list {
  flex: 1;
  padding: 28rpx;
}

/* 时间提示 */
.time-tip {
  text-align: center;
  padding: 28rpx 0;
}

.time-tip text {
  font-size: 22rpx;
  color: #A8A5A2;
  padding: 8rpx 20rpx;
  background-color: rgba(61, 58, 56, 0.05);
  border-radius: 16rpx;
}

/* 消息项 */
.message-item {
  margin-bottom: 28rpx;
}

.message-content {
  display: flex;
  align-items: flex-start;
}

/* 头像 */
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: #FFE8E4;
  flex-shrink: 0;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 128, 102, 0.15);
}

/* 气泡 - 对方消息 */
.message-item.other .message-content {
  flex-direction: row;
}

.message-item.other .avatar {
  margin-right: 16rpx;
}

.message-item.other .bubble {
  background-color: #FFFFFF;
  border-radius: 6rpx 24rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 58, 56, 0.06);
}

/* 气泡 - 我的消息 */
.message-item.mine .message-content {
  flex-direction: row-reverse;
}

.message-item.mine .avatar {
  margin-left: 16rpx;
}

.message-item.mine .bubble {
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  color: #FFFFFF;
  border-radius: 24rpx 6rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 128, 102, 0.2);
}

/* 气泡通用样式 */
.bubble {
  max-width: 65%;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-all;
  animation: bubbleIn 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes bubbleIn {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.bubble.image-bubble {
  padding: 10rpx;
  background-color: transparent;
  box-shadow: none;
}

.msg-image {
  max-width: 400rpx;
  border-radius: 20rpx;
}

/* 发送状态 */
.send-status {
  display: flex;
  align-items: center;
  margin: 0 10rpx;
  align-self: center;
}

.status-text {
  font-size: 24rpx;
  color: #A8A5A2;
}

/* ==================== 空状态 ==================== */

.empty-chat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx;
}

.empty-icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 36rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #A8A5A2;
}

/* ==================== 加载状态 ==================== */

.loading-more, .no-more {
  text-align: center;
  padding: 28rpx;
  font-size: 24rpx;
  color: #CCCCCC;
}

/* ==================== 输入区域 ==================== */

.input-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #F5F3F0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(61, 58, 56, 0.04);
}

.input-box {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  gap: 18rpx;
}

.input {
  flex: 1;
  height: 88rpx;
  padding: 0 28rpx;
  background-color: #F8F6F3;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #3D3A38;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.input:focus {
  background-color: #FFFFFF;
  border-color: #FFAB91;
}

.input::placeholder {
  color: #A8A5A2;
}

.more-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #F8F6F3;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.more-btn:active {
  background-color: #E8E5E2;
}

.more-btn .icon {
  font-size: 52rpx;
  color: #7A7673;
  font-weight: 300;
}

.send-btn {
  height: 80rpx;
  padding: 0 36rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 128, 102, 0.3);
  transition: all 0.15s ease;
}

.send-btn:active {
  transform: scale(0.94);
  box-shadow: 0 4rpx 12rpx rgba(255, 128, 102, 0.2);
}

/* ==================== 更多功能面板 ==================== */

.more-panel {
  padding: 36rpx;
  background-color: #F8F6F3;
}

.more-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 36rpx;
}

.more-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 128rpx;
}

.more-icon {
  width: 108rpx;
  height: 108rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(61, 58, 56, 0.06);
  transition: all 0.2s ease;
}

.more-item:active .more-icon {
  transform: scale(0.95);
}

.more-icon image {
  width: 60rpx;
  height: 60rpx;
}

.more-text {
  font-size: 24rpx;
  color: #7A7673;
}
