/* pages/chat/index.wxss */
.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.chat-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.back-btn {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.header-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.header-info {
  flex: 1;
}

.header-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.header-status {
  font-size: 24rpx;
  color: #52c41a;
}

.header-status.offline {
  color: #999;
}

.more-btn {
  font-size: 40rpx;
  color: #666;
}

.chat-content {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
}

.message-item.self {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin: 0 20rpx;
}

.message-content {
  max-width: 60%;
}

.message-bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.message-item:not(.self) .message-bubble {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
}

.message-item.self .message-bubble {
  background: #4a90d9;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.message-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.message-item.self .message-time {
  text-align: right;
}

.time-divider {
  text-align: center;
  padding: 20rpx 0;
}

.time-text {
  font-size: 24rpx;
  color: #999;
  background: rgba(0, 0, 0, 0.05);
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}

.system-message {
  text-align: center;
  padding: 20rpx 0;
}

.system-text {
  font-size: 24rpx;
  color: #999;
}

.input-bar {
  display: flex;
  align-items: flex-end;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.voice-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 16rpx;
}

.input-wrapper {
  flex: 1;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
}

.message-input {
  width: 100%;
  min-height: 40rpx;
  max-height: 200rpx;
  font-size: 28rpx;
}

.emoji-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 16rpx;
}

.more-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.send-btn {
  padding: 16rpx 32rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 28rpx;
  border-radius: 30rpx;
}

.extra-panel {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.extra-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.extra-icon {
  width: 100rpx;
  height: 100rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.icon-emoji {
  font-size: 48rpx;
}

.extra-text {
  font-size: 24rpx;
  color: #666;
}

.quick-replies {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.quick-item {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}
