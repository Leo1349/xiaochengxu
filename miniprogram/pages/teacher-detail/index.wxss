/* pages/teacher-detail/index.wxss - 智伴优程老师详情页柔和精致风格 */

.container {
  min-height: 100vh;
  background-color: #FFF9F5;
  padding-bottom: 160rpx;
}

/* ==================== 老师头部信息 ==================== */

.teacher-header {
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  padding: 56rpx 36rpx;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* 头部装饰圆圈 */
.teacher-header::before,
.teacher-header::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.teacher-header::before {
  width: 340rpx;
  height: 340rpx;
  top: -120rpx;
  right: -80rpx;
}

.teacher-header::after {
  width: 220rpx;
  height: 220rpx;
  bottom: -100rpx;
  left: -60rpx;
}

.teacher-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 36rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  position: relative;
  z-index: 1;
}

.teacher-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.name-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.teacher-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.teacher-title {
  font-size: 24rpx;
  color: #FFFFFF;
  padding: 6rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 100rpx;
  font-weight: 500;
}

.rating-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 18rpx;
}

.rating {
  font-size: 30rpx;
  color: #FFD700;
  font-weight: 700;
}

.order-count {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border-radius: 14rpx;
  font-weight: 500;
}

.favorite-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  margin-left: 28rpx;
  position: relative;
  z-index: 1;
  transition: all 0.25s ease;
}

.favorite-btn:active {
  transform: scale(1.12);
  background-color: rgba(255, 255, 255, 0.35);
}

.favorite-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ==================== Tab 切换 ==================== */

.tabs {
  display: flex;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F3F0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #7A7673;
  position: relative;
  font-weight: 500;
  transition: all 0.25s ease;
}

.tab-item.active {
  color: #FF8066;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 52rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 3rpx;
}

/* ==================== Tab 内容通用 ==================== */

.tab-content {
  min-height: 50vh;
}

/* ==================== 简介 Tab ==================== */

.info-section {
  padding: 36rpx 28rpx;
  background-color: #FFFFFF;
  margin-top: 24rpx;
}

.info-block {
  margin-bottom: 44rpx;
}

.info-block:last-child {
  margin-bottom: 0;
}

.block-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3D3A38;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  position: relative;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.block-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 3rpx;
}

.block-content {
  font-size: 28rpx;
  color: #5D5A58;
  line-height: 1.7;
}

.certificates {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.certificate {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #E0F2EE 0%, #F0FAF7 100%);
  color: #2E7D6B;
  font-size: 26rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.photo-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background-color: #FFE8E4;
}

/* ==================== 服务 Tab ==================== */

.service-section {
  padding: 28rpx;
}

.service-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
  transition: all 0.25s ease;
}

.service-card:active {
  transform: scale(0.99);
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #3D3A38;
  display: block;
}

.service-desc {
  font-size: 26rpx;
  color: #A8A5A2;
  margin-top: 10rpx;
  display: block;
}

.service-price {
  margin: 0 28rpx;
  text-align: right;
}

.price-value {
  font-size: 36rpx;
  color: #FF8066;
  font-weight: 700;
}

.price-unit {
  font-size: 24rpx;
  color: #A8A5A2;
}

.book-btn {
  min-width: 140rpx;
  height: 68rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: 0 6rpx 16rpx rgba(255, 128, 102, 0.25);
  transition: all 0.2s ease;
}

.book-btn:active {
  transform: scale(0.94);
}

/* ==================== 评价 Tab ==================== */

.review-section {
  padding: 36rpx 28rpx;
  background-color: #FFFFFF;
  margin-top: 24rpx;
}

.review-summary {
  display: flex;
  align-items: baseline;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #F5F3F0;
  margin-bottom: 28rpx;
}

.summary-rating {
  font-size: 60rpx;
  font-weight: 700;
  color: #FFB74D;
  margin-right: 18rpx;
  font-family: 'DM Serif Display', serif;
}

.summary-text {
  font-size: 28rpx;
  color: #3D3A38;
  margin-right: 18rpx;
  font-weight: 500;
}

.summary-count {
  font-size: 24rpx;
  color: #A8A5A2;
}

.review-list {
  display: flex;
  flex-direction: column;
}

.review-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F3F0;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.review-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background-color: #FFE8E4;
}

.review-info {
  flex: 1;
}

.review-name {
  font-size: 28rpx;
  color: #3D3A38;
  font-weight: 600;
  display: block;
}

.review-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
}

.review-service {
  font-size: 22rpx;
  color: #2E7D6B;
  font-weight: 500;
}

.review-time {
  font-size: 22rpx;
  color: #A8A5A2;
}

.review-rating {
  font-size: 24rpx;
}

.star {
  color: #FFB74D;
}

.review-content {
  font-size: 28rpx;
  color: #5D5A58;
  line-height: 1.6;
  display: block;
}

.empty-review {
  text-align: center;
  padding: 48rpx;
  color: #CCCCCC;
  font-size: 26rpx;
}

/* ==================== 案例 Tab ==================== */

.case-section {
  padding: 28rpx;
}

.case-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.case-cover {
  width: 100%;
  height: 300rpx;
  background-color: #FFE8E4;
}

.case-info {
  padding: 28rpx;
}

.case-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3A38;
  margin-bottom: 14rpx;
  display: block;
}

.case-desc {
  font-size: 26rpx;
  color: #7A7673;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.empty-case {
  text-align: center;
  padding: 48rpx;
  color: #CCCCCC;
}

/* ==================== 底部操作栏 ==================== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 36rpx 48rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -6rpx 24rpx rgba(61, 58, 56, 0.06);
  z-index: 100;
}

.book-now-btn {
  width: 90%;
  max-width: 600rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 128, 102, 0.35);
  transition: all 0.2s ease;
}

.book-now-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(255, 128, 102, 0.25);
}

/* ==================== 加载状态 ==================== */

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 50vh;
  color: #A8A5A2;
  font-size: 26rpx;
}
