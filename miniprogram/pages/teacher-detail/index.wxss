/* pages/teacher-detail/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.teacher-header {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  padding: 60rpx 30rpx 80rpx;
  color: #fff;
  display: flex;
  align-items: center;
}

.header-content {
  display: flex;
  align-items: center;
}

.teacher-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 30rpx;
  flex-shrink: 0;
}

.teacher-info {
  flex: 1;
}

.teacher-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.teacher-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.teacher-rating {
  display: flex;
  align-items: center;
}

.star {
  font-size: 28rpx;
}

.rating-text {
  font-size: 28rpx;
  margin-left: 12rpx;
}

.stats-bar {
  display: flex;
  background: #fff;
  margin: -40rpx 30rpx 0;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #eee;
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  margin-bottom: 20rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.service-list {
  display: flex;
  flex-direction: column;
}

.service-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.service-item:last-child {
  border-bottom: none;
}

.service-name {
  font-size: 28rpx;
  color: #333;
}

.service-price {
  font-size: 32rpx;
  color: #ff9500;
  font-weight: bold;
}

.cert-list {
  display: flex;
  flex-wrap: wrap;
}

.cert-item {
  display: flex;
  align-items: center;
  width: 48%;
  margin-bottom: 16rpx;
}

.cert-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.cert-name {
  font-size: 26rpx;
  color: #333;
}

.case-list {
  display: flex;
  flex-direction: column;
}

.case-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.case-item:last-child {
  border-bottom: none;
}

.case-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.case-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.review-list {
  display: flex;
  flex-direction: column;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.review-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.review-info {
  flex: 1;
}

.review-name {
  font-size: 26rpx;
  color: #333;
}

.review-time {
  font-size: 22rpx;
  color: #999;
}

.review-rating {
  font-size: 24rpx;
}

.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.more-reviews {
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: #4a90d9;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
}

.btn-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 22rpx;
  color: #666;
}

.book-btn {
  flex: 1;
  height: 88rpx;
  background: #4a90d9;
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Fix for missing styles */
.contact-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
  background: transparent;
  padding: 0;
  line-height: 1.2;
  width: auto;
}

.contact-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
}

.contact-btn text {
  font-size: 20rpx;
  color: #666;
}

.favorite-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  margin-left: 20rpx;
}

.favorite-icon {
  width: 36rpx;
  height: 36rpx;
}

/* Tabs Styles */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #4a90d9;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #4a90d9;
  border-radius: 2rpx;
}

/* Info Section Styles */
.info-section {
  padding: 20rpx 30rpx;
  background: #fff;
  margin-top: 20rpx;
}

.info-block {
  margin-bottom: 40rpx;
}

.info-block:last-child {
  margin-bottom: 0;
}

.block-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
  padding-left: 16rpx;
  border-left: 8rpx solid #4a90d9;
  line-height: 1;
}

.block-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

.certificates {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.certificate {
  padding: 8rpx 20rpx;
  background: #f0f7ff;
  color: #4a90d9;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.photo-item {
  width: 210rpx;
  height: 210rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

/* Service Card Styles */
.service-section {
  padding: 20rpx 30rpx;
}

.service-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.service-info {
  flex: 1;
}

.service-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.service-price {
  margin: 0 20rpx;
  text-align: right;
}

.price-value {
  font-size: 36rpx;
  color: #ff9500;
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
  color: #999;
}

.service-card .book-btn {
  width: 120rpx;
  height: 60rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
  flex: none;
}

/* Review Section Styles */
.review-section {
  padding: 20rpx 30rpx;
  background: #fff;
  margin-top: 20rpx;
}

.review-summary {
  display: flex;
  align-items: baseline;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 30rpx;
}

.summary-rating {
  font-size: 60rpx;
  font-weight: bold;
  color: #ff9500;
  margin-right: 16rpx;
}

.summary-text {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.summary-count {
  font-size: 24rpx;
  color: #999;
}

/* Case Section Styles */
.case-section {
  padding: 20rpx 30rpx;
}

.case-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.case-cover {
  width: 100%;
  height: 300rpx;
  background: #f5f5f5;
}

.case-info {
  padding: 24rpx;
}

.case-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.case-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.photo-item {
  width: 210rpx;
  height: 210rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}
