/* pages/mine/index.wxss - 智伴优程个人中心柔和精致风格 */

.container {
  padding: 0;
  min-height: 100vh;
  background-color: #FFF9F5;
  padding-bottom: 160rpx;
}

/* ==================== 顶部用户区域 ==================== */

.user-section {
  position: relative;
  padding: 28rpx;
}

.user-bg {
  height: 260rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  position: relative;
  overflow: hidden;
}

/* 背景装饰圆圈 */
.user-bg::before,
.user-bg::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.user-bg::before {
  width: 240rpx;
  height: 240rpx;
  top: -80rpx;
  right: -60rpx;
}

.user-bg::after {
  width: 160rpx;
  height: 160rpx;
  bottom: -50rpx;
  left: 12%;
}

.user-info {
  position: relative;
  margin-top: -180rpx;
  margin-left: 20rpx;
  margin-right: 20rpx;
  padding: 36rpx;
  border-radius: 24rpx;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(61, 58, 56, 0.08);
}

.user-info.not-login {
  background-color: #FFFFFF;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  background-color: #FFE8E4;
  border: 5rpx solid #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 128, 102, 0.25),
              0 0 0 6rpx rgba(255, 128, 102, 0.1);
  overflow: hidden;
  transition: transform 0.3s ease;
}

.user-avatar:active {
  transform: scale(1.05);
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D3A38;
  display: block;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.user-phone {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #A8A5A2;
  display: block;
}

.user-role {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #FFE8E4 0%, #FFF5F0 100%);
  border: 1rpx solid rgba(255, 128, 102, 0.2);
}

.role-text {
  font-size: 22rpx;
  color: #FF8066;
  font-weight: 600;
}

.switch-role-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
  background-color: #F8F6F3;
  color: #FF8066;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.switch-role-btn:active {
  background-color: #FFE8E4;
  transform: scale(0.97);
}

.switch-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
}

.arrow-icon {
  font-size: 36rpx;
  color: #CCCCCC;
}

.login-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D3A38;
  display: block;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.login-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #A8A5A2;
  display: block;
}

/* ==================== 统计数据 ==================== */

.statistics-section {
  margin: 28rpx 48rpx 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  padding: 36rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.statistics-section.teacher {
  background: linear-gradient(135deg, #FFF9F0 0%, #FFE8DC 100%);
  border: 1rpx solid rgba(255, 183, 77, 0.2);
}

.stat-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  transition: transform 0.2s ease;
}

.stat-item:active {
  transform: scale(0.96);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #3D3A38;
  font-family: 'DM Serif Display', serif;
}

.statistics-section.teacher .stat-value {
  color: #FF8066;
}

.stat-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7A7673;
}

.stat-divider {
  width: 1rpx;
  height: 50%;
  background: linear-gradient(180deg, transparent 0%, #E8E5E2 50%, transparent 100%);
  position: absolute;
  right: 0;
  top: 25%;
}

/* ==================== 快捷入口 ==================== */

.quick-entry {
  margin: 28rpx 28rpx 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 20rpx;
  display: flex;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.quick-item:active {
  transform: scale(0.93) translateY(-4rpx);
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 18rpx;
  transition: transform 0.2s ease;
}

.quick-item:active .quick-icon {
  transform: translateY(-4rpx);
}

.quick-text {
  font-size: 24rpx;
  color: #3D3A38;
  font-weight: 500;
}

/* ==================== 菜单列表 ==================== */

.menu-section {
  margin: 28rpx 28rpx 0;
}

.menu-group {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.group-title {
  padding: 28rpx 32rpx 18rpx;
  font-size: 26rpx;
  color: #A8A5A2;
  font-weight: 500;
  border-bottom: 1rpx solid #F5F3F0;
}

.menu-list {
  padding: 0 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F5F3F0;
  transition: all 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #FFFAF8;
  padding-left: 12rpx;
}

.menu-icon {
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  overflow: hidden;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #3D3A38;
  font-weight: 500;
}

/* ==================== 版本信息 ==================== */

.version-info {
  padding: 48rpx 0 72rpx;
  text-align: center;
  font-size: 22rpx;
  color: #CCCCCC;
}
