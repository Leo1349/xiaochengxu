/* pages/mine/index.wxss */

.container {
  padding: 0;
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 140rpx;
}

/* 顶部用户区域 */
.user-section {
  position: relative;
  padding: 24rpx 24rpx 0;
}

.user-bg {
  height: 220rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
}

.user-info {
  position: relative;
  margin-top: -170rpx;
  padding: 22rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
}

.user-info.not-login {
  background: rgba(255, 255, 255, 0.95);
}

.user-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  margin-right: 18rpx;
  background: #f2f3f5;
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.user-phone {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
}

.user-role {
  margin-top: 10rpx;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(74, 144, 217, 0.08);
}

.role-text {
  font-size: 22rpx;
  color: #4a90d9;
}

.switch-role-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(74, 144, 217, 0.08);
  color: #4a90d9;
  font-size: 22rpx;
}

.switch-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
}

.arrow-icon {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.35);
  line-height: 1;
}

.login-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.login-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 统计 */
.statistics-section {
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  padding: 18rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  background: rgba(0, 0, 0, 0.06);
}

/* 快捷入口 */
.quick-entry {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
}

.quick-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 12rpx;
  filter: drop-shadow(0 4rpx 6rpx rgba(0, 0, 0, 0.1));
}

.quick-text {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

/* 菜单 */
.menu-section {
  margin: 20rpx 24rpx 0;
}

.menu-group {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.group-title {
  padding: 24rpx 24rpx 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.menu-list {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.menu-item:first-child {
  border-top: none;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  /* Icon shadow makes them pop */
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.08));
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 版本 */
.version-info {
  padding: 28rpx 0 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbbbbb;
}
