/* pages/publish/index.wxss */
.header-tip {
  display: flex;
  align-items: center;
  background-color: #FFF3E0;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #F57C00;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
}

.form-item-vertical {
  padding: 24rpx 0;
}

.label {
  color: #3D3A38;
  font-weight: 500;
  min-width: 160rpx;
}

.label.required::before {
  content: '*';
  color: #FF8066;
  margin-right: 4rpx;
}

.content {
  color: #3D3A38;
}

.arrow {
  color: #A8A5A2;
  font-family: monospace;
}

.textarea-wrapper {
  background-color: #F8F6F3;
  border-radius: 12rpx;
  padding: 20rpx;
}

.textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 图片上传网格 */
.media-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.media-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 8rpx;
}

.media-preview {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 34rpx;
  font-size: 24rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  margin: 8rpx;
  background-color: #F8F6F3;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 60rpx;
  color: #A8A5A2;
  font-weight: 300;
  margin-top: -8rpx;
}

/* 服务介绍部分 */
.info-title {
  color: #3D3A38;
  margin-bottom: 20rpx;
}

.form-row {
  margin-bottom: 24rpx;
}

.form-row .label {
  margin-bottom: 12rpx;
  color: #5D5A58;
  font-size: 26rpx;
}

.input {
  background-color: #F8F6F3;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.radio-group {
  display: flex;
  align-items: center;
}

/* 底部固定栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.submit-btn {
  width: 90%;
  margin: 0;
}

/* ==================== 手动输入模式样式 ==================== */

.form-item-column {
  padding: 24rpx 0;
}

.form-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.mode-switch {
  padding: 6rpx 20rpx;
  background-color: #FFF8F5;
  border: 1rpx solid #FFCCBC;
  border-radius: 24rpx;
  transition: all 0.3s;
}

.mode-switch:active {
  background-color: #FFEBE0;
}

.switch-text {
  font-size: 22rpx;
  color: #FF8066;
}

.form-item-body {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  min-height: 48rpx;
}

/* 输入模式下的输入框 */
.input-inline {
  width: 100%;
  height: 84rpx;
  background-color: #F9F9F9;
  border: 1rpx solid #F0F0F0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #3D3A38;
  box-sizing: border-box;
}

.input-inline:focus {
  background-color: #FFFFFF;
  border-color: #FFCCBC;
}
