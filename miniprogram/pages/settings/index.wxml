<!--pages/settings/index.wxml-->
<view class="container">
  <!-- 个人信息 -->
  <view class="section" wx:if="{{isLoggedIn}}">
    <view class="section-title">个人信息</view>
    <view class="setting-list">
      <view class="setting-item" bindtap="editAvatar">
        <text class="setting-label">头像</text>
        <view class="setting-value">
          <image class="avatar" src="{{userInfo.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image>
          <text class="arrow-icon">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="editNickName">
        <text class="setting-label">昵称</text>
        <view class="setting-value">
          <text>{{userInfo.nickName || '未设置'}}</text>
          <text class="arrow-icon">›</text>
        </view>
      </view>
      <view class="setting-item">
        <text class="setting-label">手机号</text>
        <view class="setting-value">
          <text>{{userInfo.phone || '未绑定'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 通知设置 -->
  <view class="section">
    <view class="section-title">通知设置</view>
    <view class="setting-list">
      <view class="setting-item">
        <text class="setting-label">消息通知</text>
        <switch checked="{{settings.notification}}" bindchange="toggleNotification" color="#4A90E2"></switch>
      </view>
      <view class="setting-item">
        <text class="setting-label">声音</text>
        <switch checked="{{settings.sound}}" bindchange="toggleSound" color="#4A90E2"></switch>
      </view>
      <view class="setting-item">
        <text class="setting-label">震动</text>
        <switch checked="{{settings.vibrate}}" bindchange="toggleVibrate" color="#4A90E2"></switch>
      </view>
    </view>
  </view>

  <!-- 其他设置 -->
  <view class="section">
    <view class="section-title">其他</view>
    <view class="setting-list">
      <view class="setting-item" bindtap="clearCache">
        <text class="setting-label">清除缓存</text>
        <view class="setting-value">
          <text class="cache-size">{{cacheSize}}</text>
          <text class="arrow-icon">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="viewUserAgreement">
        <text class="setting-label">用户协议</text>
        <view class="setting-value">
          <text class="arrow-icon">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="viewPrivacyPolicy">
        <text class="setting-label">隐私政策</text>
        <view class="setting-value">
          <text class="arrow-icon">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="checkUpdate">
        <text class="setting-label">检查更新</text>
        <view class="setting-value">
          <text class="version">v{{version}}</text>
          <text class="arrow-icon">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="aboutUs">
        <text class="setting-label">关于我们</text>
        <view class="setting-value">
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 未登录提示 -->
  <view class="login-section" wx:if="{{!isLoggedIn}}">
    <button class="login-btn" bindtap="goToLogin">登录/注册</button>
  </view>

  <!-- 版权信息 -->
  <view class="copyright">
    <text>智伴优程 ? 2024-2026</text>
  </view>
</view>
