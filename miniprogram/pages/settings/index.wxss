/* pages/settings/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 30rpx 12rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-emoji {
  font-size: 32rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-value {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.switch-wrapper {
  transform: scale(0.9);
}

.version-info {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}

.logout-section {
  padding: 0 30rpx 40rpx;
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  color: #ff4444;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ff4444;
}

.account-section {
  padding: 30rpx;
}

.account-card {
  display: flex;
  align-items: center;
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
}

.account-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.account-info {
  flex: 1;
}

.account-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.account-phone {
  font-size: 26rpx;
  color: #999;
}

.edit-btn {
  padding: 12rpx 24rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 26rpx;
  border-radius: 20rpx;
}

.storage-info {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin: 0 30rpx;
}

.storage-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.storage-detail {
  flex: 1;
}

.storage-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.storage-size {
  font-size: 24rpx;
  color: #999;
}

.clear-btn {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 20rpx;
}

.about-section {
  padding: 0 30rpx 30rpx;
}

.about-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.about-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.about-version {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.about-links {
  display: flex;
  justify-content: center;
}

.link-item {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #4a90d9;
  border-right: 1rpx solid #eee;
}

.link-item:last-child {
  border-right: none;
}

.confirm-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 20rpx 30rpx 40rpx;
  text-align: center;
}

.modal-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
  border-right: 1rpx solid #eee;
}

.modal-btn:last-child {
  border-right: none;
}

.modal-btn.cancel {
  color: #999;
}

.modal-btn.confirm {
  color: #ff4444;
}

/* ---- WXML 对齐补丁：container/setting-*（避免样式不生效导致“像空白页”） ---- */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 0 40rpx;
  box-sizing: border-box;
}

.setting-list {
  background: #fff;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #333;
}

.setting-value {
  display: flex;
  align-items: center;
  color: #666;
  font-size: 28rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 12rpx;
}

.arrow-icon {
  font-size: 32rpx;
  color: #c5c5c5;
  margin-left: 12rpx;
  line-height: 1;
}

.cache-size,
.version {
  color: #999;
  margin-right: 6rpx;
}

.login-section {
  padding: 0 30rpx 40rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.copyright {
  text-align: center;
  font-size: 24rpx;
  color: #aaa;
  padding-top: 20rpx;
}
