/* pages/settings/index.wxss - 智伴家设置页柔和精致风格 */

.container {
  min-height: 100vh;
  background-color: #FFF9F5;
  padding: 28rpx;
  padding-bottom: 140rpx;
}

/* ==================== 区块 ==================== */

.section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
  overflow: hidden;
}

.section-title {
  padding: 28rpx 36rpx;
  font-size: 24rpx;
  color: #A8A5A2;
  font-weight: 600;
  border-bottom: 1rpx solid #F5F3F0;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* ==================== 设置项 ==================== */

.setting-list {
  padding: 0 36rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 0;
  border-bottom: 1rpx solid #F5F3F0;
  transition: all 0.2s ease;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background-color: #FFFAF8;
  margin: 0 -36rpx;
  padding: 36rpx;
}

.setting-label {
  font-size: 32rpx;
  color: #3D3A38;
  font-weight: 500;
}

.setting-value {
  display: flex;
  align-items: center;
  gap: 18rpx;
  font-size: 28rpx;
  color: #7A7673;
}

.arrow-icon {
  font-size: 36rpx;
  color: #CCCCCC;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background-color: #FFE8E4;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 128, 102, 0.15);
}

.cache-size, .version {
  color: #A8A5A2;
}

/* ==================== 登录/退出按钮 ==================== */

.logout-section, .login-section {
  padding: 36rpx;
}

.logout-btn {
  height: 104rpx;
  background-color: #FFFFFF;
  color: #E57373;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 52rpx;
  border: 2rpx solid #E57373;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.logout-btn:active {
  background-color: #FFEBEE;
  transform: scale(0.98);
}

.login-btn {
  height: 104rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(255, 128, 102, 0.35);
  transition: all 0.2s ease;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(255, 128, 102, 0.25);
}

/* ==================== 版权信息 ==================== */

.copyright {
  text-align: center;
  padding: 48rpx 0;
  font-size: 22rpx;
  color: #CCCCCC;
}
