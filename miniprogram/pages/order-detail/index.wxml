<!--pages/order-detail/index.wxml-->
<view class="container" wx:if="{{!loading && order}}">
  <!-- 订单状态 -->
  <view class="status-section {{order.status}}">
    <text class="status-text">{{order.statusText}}</text>
    <text class="status-desc" wx:if="{{order.status === 'pending'}}">等待陪伴师确认订单</text>
    <text class="status-desc" wx:if="{{order.status === 'confirmed'}}">陪伴师已确认，请准时等待服务</text>
    <text class="status-desc" wx:if="{{order.status === 'ongoing'}}">服务进行中</text>
    <text class="status-desc" wx:if="{{order.status === 'completed'}}">服务已完成，感谢您的信任</text>
    <text class="status-desc" wx:if="{{order.status === 'cancelled'}}">订单已取消</text>
  </view>

  <!-- 陪伴师信息 -->
  <view class="card teacher-card" bindtap="viewTeacherDetail">
    <view class="card-title">陪伴师信息</view>
    <view class="teacher-info">
      <image class="teacher-avatar" src="{{order.teacher.avatar}}" mode="aspectFill"></image>
      <view class="teacher-detail">
        <text class="teacher-name">{{order.teacher.name}}</text>
        <text class="teacher-title">{{order.teacher.title}}</text>
      </view>
        <text class="arrow-icon">›</text>
    </view>
  </view>

  <!-- 服务信息 -->
  <view class="card">
    <view class="card-title">服务信息</view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">服务类型</text>
        <text class="info-value">{{order.service.name}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">服务孩子</text>
        <text class="info-value">{{order.child.name}}（{{order.child.gender}}，{{order.child.age}}岁，{{order.child.grade}}）</text>
      </view>
      <view class="info-item">
        <text class="info-label">服务日期</text>
        <text class="info-value">{{order.serviceDate}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">服务时间</text>
        <text class="info-value">{{order.serviceTime}} 开始，共{{order.duration}}小时</text>
      </view>
      <view class="info-item">
        <text class="info-label">服务地址</text>
        <text class="info-value">{{order.address}}</text>
      </view>
      <view class="info-item" wx:if="{{order.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card">
    <view class="card-title">订单信息</view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">订单编号</text>
        <view class="info-value-row">
          <text class="info-value">{{order.id}}</text>
          <text class="copy-btn" bindtap="copyOrderId">复制</text>
        </view>
      </view>
      <view class="info-item">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createTime}}</text>
      </view>
      <view class="info-item" wx:if="{{order.confirmTime}}">
        <text class="info-label">确认时间</text>
        <text class="info-value">{{order.confirmTime}}</text>
      </view>
      <view class="info-item" wx:if="{{order.startTime}}">
        <text class="info-label">开始时间</text>
        <text class="info-value">{{order.startTime}}</text>
      </view>
      <view class="info-item" wx:if="{{order.endTime}}">
        <text class="info-label">完成时间</text>
        <text class="info-value">{{order.endTime}}</text>
      </view>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="card">
    <view class="card-title">费用明细</view>
    <view class="price-list">
      <view class="price-item">
        <text class="price-label">服务费用</text>
        <text class="price-value">¥{{order.totalPrice}}</text>
      </view>
      <view class="price-item" wx:if="{{order.discountPrice > 0}}">
        <text class="price-label">优惠（{{order.couponName}}）</text>
        <text class="price-value discount">-¥{{order.discountPrice}}</text>
      </view>
      <view class="price-item total">
        <text class="price-label">实付金额</text>
        <text class="price-value final">¥{{order.finalPrice}}</text>
      </view>
    </view>
  </view>

  <!-- 评价信息 -->
  <view class="card" wx:if="{{order.review}}">
    <view class="card-title">我的评价</view>
    <view class="review-content">
      <view class="review-rating">
        <text class="star" wx:for="{{order.review.rating}}" wx:key="*this">★</text>
        <text class="empty-star" wx:for="{{5 - order.review.rating}}" wx:key="*this">☆</text>
      </view>
      <view class="review-tags" wx:if="{{order.review.tags.length > 0}}">
        <text class="tag" wx:for="{{order.review.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <text class="review-text">{{order.review.content}}</text>
      <text class="review-time">{{order.review.time}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <!-- 家长端操作 -->
    <block wx:if="{{currentRole === 'parent'}}">
      <button class="action-btn default" wx:if="{{order.status === 'pending'}}" bindtap="cancelOrder">取消订单</button>
      <button class="action-btn primary" wx:if="{{order.status === 'pending' || order.status === 'confirmed' || order.status === 'ongoing'}}" bindtap="contactUser">联系老师</button>
      
      <button class="action-btn default" wx:if="{{order.status === 'completed' && !order.review}}" bindtap="showReview">去评价</button>
      <button class="action-btn primary" wx:if="{{order.status === 'completed' || order.status === 'cancelled'}}" bindtap="reBook">再次预约</button>
    </block>
    
    <!-- 陪伴师端操作 -->
    <block wx:if="{{currentRole === 'teacher'}}">
      <button class="action-btn default" wx:if="{{order.status === 'pending'}}" bindtap="cancelOrder">拒绝订单</button>
      <button class="action-btn primary" wx:if="{{order.status === 'pending'}}" bindtap="confirmOrder">接受订单</button>
      
      <button class="action-btn default" wx:if="{{order.status === 'confirmed' || order.status === 'ongoing'}}" bindtap="contactUser">联系家长</button>
      <button class="action-btn primary" wx:if="{{order.status === 'confirmed'}}" bindtap="startService">开始服务</button>
      <button class="action-btn primary" wx:if="{{order.status === 'ongoing'}}" bindtap="completeService">完成服务</button>
    </block>
  </view>

  <!-- 评价弹窗 -->
  <view class="review-modal-mask" wx:if="{{showReviewModal}}" bindtap="hideReview"></view>
  <view class="review-modal {{showReviewModal ? 'show' : ''}}">
    <view class="modal-header">
      <text class="modal-title">评价陪伴师</text>
      <image class="close-icon" src="/images/icons/close.png" mode="aspectFit" bindtap="hideReview"></image>
    </view>
    
    <view class="modal-content">
      <!-- 评分 -->
      <view class="rating-section">
        <text class="rating-label">服务评分</text>
        <view class="rating-stars">
          <text class="star {{reviewData.rating >= 1 ? 'active' : ''}}" data-rating="1" bindtap="setRating">★</text>
          <text class="star {{reviewData.rating >= 2 ? 'active' : ''}}" data-rating="2" bindtap="setRating">★</text>
          <text class="star {{reviewData.rating >= 3 ? 'active' : ''}}" data-rating="3" bindtap="setRating">★</text>
          <text class="star {{reviewData.rating >= 4 ? 'active' : ''}}" data-rating="4" bindtap="setRating">★</text>
          <text class="star {{reviewData.rating >= 5 ? 'active' : ''}}" data-rating="5" bindtap="setRating">★</text>
        </view>
      </view>
      
      <!-- 评价标签 -->
      <view class="tags-section">
        <text class="tags-label">选择标签（最多3个）</text>
        <view class="tags-list">
          <text class="tag {{reviewData.tags.indexOf(item) > -1 ? 'active' : ''}}" 
                wx:for="{{reviewTags}}" 
                wx:key="*this"
                data-tag="{{item}}"
                bindtap="toggleTag">{{item}}</text>
        </view>
      </view>
      
      <!-- 评价内容 -->
      <view class="content-section">
        <textarea class="review-textarea" placeholder="请输入您的评价..." value="{{reviewData.content}}" bindinput="onReviewInput" maxlength="500"></textarea>
      </view>
    </view>
    
    <view class="modal-footer">
      <button class="submit-btn" bindtap="submitReview">提交评价</button>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-container" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
