/* pages/order-detail/index.wxss - TDesign 风格订单详情样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding-bottom: 140rpx;
}

/* ==================== 订单状态区域 ==================== */

.status-section {
  padding: 40rpx 32rpx 80rpx;
  background: linear-gradient(135deg, #3D7EFF 0%, #0052D9 100%);
  position: relative;
  overflow: hidden;
}

/* 状态装饰 */
.status-section::before,
.status-section::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.status-section::before {
  width: 200rpx;
  height: 200rpx;
  top: -60rpx;
  right: -40rpx;
}

.status-section::after {
  width: 120rpx;
  height: 120rpx;
  bottom: 0;
  left: 10%;
}

/* 状态颜色变化 */
.status-section.pending {
  background: linear-gradient(135deg, #FF8F1F 0%, #FF6600 100%);
}

.status-section.confirmed,
.status-section.ongoing {
  background: linear-gradient(135deg, #3D7EFF 0%, #0052D9 100%);
}

.status-section.completed {
  background: linear-gradient(135deg, #00B578 0%, #008F5D 100%);
}

.status-section.cancelled {
  background: linear-gradient(135deg, #999999 0%, #666666 100%);
}

.status-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  position: relative;
  z-index: 1;
}

.status-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* ==================== 通用卡片 ==================== */

.card {
  margin: 24rpx 24rpx 0;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  width: 8rpx;
  height: 32rpx;
  background-color: #3D7EFF;
  border-radius: 4rpx;
}

/* ==================== 陪伴师卡片 ==================== */

.teacher-card { position: relative; margin-top: -40rpx; }

.teacher-info {
  display: flex;
  align-items: center;
}

.teacher-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background-color: #F5F6F8;
  flex-shrink: 0;
}

.teacher-detail {
  flex: 1;
  min-width: 0;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
}

.teacher-title {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
  display: block;
}

.arrow-icon { font-size: 32rpx; color: #CCCCCC; }

/* ==================== 信息列表 ==================== */

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
  width: 160rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
  text-align: right;
}

.info-value-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
}

.copy-btn {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #3D7EFF;
  background-color: #E6F0FF;
  border-radius: 6rpx;
}

/* ==================== 费用明细 ==================== */

.price-list {
  display: flex;
  flex-direction: column;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.price-label { font-size: 26rpx; color: #666666; }
.price-value { font-size: 26rpx; color: #333333; }
.price-value.discount { color: #00B578; }

.price-item.total {
  margin-top: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.price-item.total .price-label { font-weight: 500; color: #333333; }

.price-value.final {
  font-size: 36rpx;
  font-weight: 600;
  color: #FF3B30;
}

/* ==================== 评价内容 ==================== */

.review-content {
  display: flex;
  flex-direction: column;
}

.review-rating { margin-bottom: 16rpx; }
.star { font-size: 32rpx; color: #FFD700; margin-right: 8rpx; }
.empty-star { font-size: 32rpx; color: #E0E0E0; margin-right: 8rpx; }

.review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.review-tags .tag {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  background-color: #E6F0FF;
  color: #3D7EFF;
  border-radius: 8rpx;
}

.review-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.review-time {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* ==================== 底部操作栏 ==================== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx 40rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn:active { opacity: 0.9; }

.action-btn.default {
  background-color: #F5F6F8;
  color: #666666;
}

.action-btn.primary {
  background: #3D7EFF;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(61, 126, 255, 0.3);
}

/* ==================== 评价弹窗 ==================== */

.review-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.review-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.review-modal.show { transform: translateY(0); }

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
}

.modal-content {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.rating-section, .tags-section, .content-section { margin-bottom: 40rpx; }

.rating-label, .tags-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 24rpx;
  display: block;
}

.rating-stars {
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.rating-stars .star {
  font-size: 64rpx;
  color: #E0E0E0;
}

.rating-stars .star.active { color: #FFD700; }

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tags-list .tag {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  background-color: #F5F6F8;
  color: #666666;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
}

.tags-list .tag.active {
  background-color: #E6F0FF;
  color: #3D7EFF;
  border-color: #3D7EFF;
}

.review-textarea {
  width: 100%;
  height: 240rpx;
  padding: 24rpx;
  background-color: #F9FAFC;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  padding: 24rpx 32rpx 40rpx;
  border-top: 1rpx solid #F0F0F0;
}

.submit-btn {
  height: 88rpx;
  background: #3D7EFF;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
