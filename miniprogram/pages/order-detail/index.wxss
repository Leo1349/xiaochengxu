/* pages/order-detail/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 160rpx;
}

.status-header {
  padding: 40rpx 30rpx;
  color: #fff;
}

.status-header.pending {
  background: linear-gradient(135deg, #ff9500 0%, #ff6b00 100%);
}

.status-header.confirmed {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
}

.status-header.ongoing {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.status-header.completed {
  background: linear-gradient(135deg, #999 0%, #666 100%);
}

.status-header.cancelled {
  background: linear-gradient(135deg, #999 0%, #666 100%);
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.teacher-info {
  display: flex;
  align-items: center;
}

.teacher-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.teacher-detail {
  flex: 1;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.teacher-title {
  font-size: 26rpx;
  color: #666;
}

.contact-btn {
  padding: 16rpx 32rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-value.highlight {
  color: #ff9500;
  font-weight: bold;
}

.child-info {
  display: flex;
  align-items: center;
}

.child-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.child-detail {
  flex: 1;
}

.child-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.child-grade {
  font-size: 24rpx;
  color: #999;
}

.timeline {
  display: flex;
  flex-direction: column;
  padding-left: 30rpx;
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 30rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: -22rpx;
  top: 20rpx;
  width: 2rpx;
  height: calc(100% - 20rpx);
  background: #eee;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: -30rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ddd;
}

.timeline-item.active .timeline-dot {
  background: #4a90d9;
}

.timeline-content {
  flex: 1;
}

.timeline-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #999;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.bottom-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.bottom-btn:last-child {
  margin-right: 0;
}

.bottom-btn.primary {
  background: #4a90d9;
  color: #fff;
}

.bottom-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.bottom-btn.danger {
  background: #fff;
  color: #ff4444;
  border: 1rpx solid #ff4444;
}

.review-section {
  display: flex;
  flex-direction: column;
}

.review-rating {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.rating-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.stars {
  display: flex;
}

.star-item {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.review-input {
  width: 100%;
  min-height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ===== 以下为与 pages/order-detail/index.wxml 对齐的样式（覆盖/补齐）===== */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 160rpx;
}

.status-section {
  border-radius: 16rpx;
  padding: 22rpx;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.status-section.pending {
  background: linear-gradient(135deg, #ff9500 0%, #ff6b00 100%);
}

.status-section.confirmed {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
}

.status-section.ongoing {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.status-section.completed,
.status-section.cancelled {
  background: linear-gradient(135deg, #999999 0%, #666666 100%);
}

.status-text {
  font-size: 34rpx;
  font-weight: 800;
}

.status-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 14rpx;
}

.teacher-info {
  display: flex;
  align-items: center;
}

.teacher-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #f2f3f5;
  margin-right: 14rpx;
}

.teacher-detail {
  flex: 1;
  min-width: 0;
}

.teacher-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
}

.teacher-title {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
}

.arrow-icon {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.35);
  line-height: 1;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  flex: none;
  font-size: 24rpx;
  color: #999999;
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #333333;
  word-break: break-all;
}

.info-value-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  flex: 1;
}

.copy-btn {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(74, 144, 217, 0.1);
  color: #4a90d9;
  font-size: 22rpx;
}

.price-list {
  display: flex;
  flex-direction: column;
}

.price-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.price-item.total {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  margin-top: 10rpx;
  padding-top: 16rpx;
}

.price-label {
  font-size: 24rpx;
  color: #666666;
}

.price-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #333333;
}

.price-value.discount {
  color: #ff4444;
}

.price-value.final {
  color: #ff9500;
}

.review-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.review-rating {
  display: flex;
  gap: 6rpx;
}

.star {
  color: #ff9500;
}

.empty-star {
  color: rgba(255, 149, 0, 0.35);
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 6rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(74, 144, 217, 0.08);
  color: #4a90d9;
  font-size: 22rpx;
}

.review-text {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.6;
}

.review-time {
  font-size: 22rpx;
  color: #999999;
}
