/* pages/case-detail/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.case-header {
  background: #fff;
  padding: 30rpx;
}

.case-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.case-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.meta-icon {
  margin-right: 8rpx;
}

.case-tag {
  padding: 6rpx 16rpx;
  background: rgba(74, 144, 217, 0.1);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #4a90d9;
}

.teacher-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.teacher-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.teacher-info {
  flex: 1;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.teacher-title {
  font-size: 26rpx;
  color: #666;
}

.view-btn {
  padding: 16rpx 32rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.case-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.case-content .paragraph {
  margin-bottom: 24rpx;
}

.case-content .paragraph:last-child {
  margin-bottom: 0;
}

.image-gallery {
  display: flex;
  flex-wrap: wrap;
}

.gallery-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.result-box {
  background: rgba(82, 196, 26, 0.1);
  border-radius: 12rpx;
  padding: 24rpx;
}

.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #52c41a;
}

.result-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.stats-bar {
  display: flex;
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #eee;
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.related-cases {
  padding: 0 30rpx 30rpx;
}

.related-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.related-list {
  display: flex;
  flex-direction: column;
}

.related-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.related-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.related-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.related-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.related-meta {
  font-size: 24rpx;
  color: #999;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-icon.liked {
  color: #ff4444;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.book-btn {
  flex: 1;
  height: 88rpx;
  background: #4a90d9;
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 30rpx;
}

/* ---- WXML ¶ÔÆë²¹¶¡£ºcontainer/cover-image/teacher-section/bottom-bar µÈ ---- */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.cover-image {
  width: 100%;
  height: 420rpx;
  background: #eee;
}

.title-section {
  background: #fff;
  padding: 24rpx 30rpx 20rpx;
}

.category-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: rgba(74, 144, 217, 0.12);
  color: #4a90d9;
  font-size: 22rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.case-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.create-time {
  font-size: 24rpx;
  color: #999;
}

.stats {
  display: flex;
  gap: 14rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
}

.teacher-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
}

.teacher-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: #eee;
}

.teacher-info {
  flex: 1;
}

.arrow-icon {
  font-size: 34rpx;
  color: #c5c5c5;
  line-height: 1;
}

.info-section,
.content-section,
.images-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 26rpx 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 18rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  padding: 12rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: #999;
}

.info-value {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #333;
}

.content-block {
  margin-top: 18rpx;
}

.block-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.title-icon {
  width: 8rpx;
  height: 28rpx;
  background: #4a90d9;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.block-content {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-line;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.case-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  background: #eee;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.action-icons {
  display: flex;
  align-items: center;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  background: transparent;
  border: none;
}

.action-icon {
  font-size: 34rpx;
  line-height: 1;
  margin-bottom: 8rpx;
  color: #666;
}

.action-item.active .action-icon {
  color: #ff4444;
}

.action-item text {
  font-size: 22rpx;
  color: #666;
}
