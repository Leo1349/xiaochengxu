/* pages/case-detail/index.wxss - TDesign 风格案例详情页样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding: 24rpx;
}

.case-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 24rpx;
}

.case-cover-large {
  width: 100%;
  height: 480rpx;
  background-color: #F9FAFC;
}

.case-content { padding: 32rpx; }

.case-title-large {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 24rpx;
  line-height: 1.4;
  display: block;
}

.author-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.author-avatar-large {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #F5F6F8;
}

.author-detail { flex: 1; }
.author-name-large { font-size: 30rpx; font-weight: 500; color: #333333; display: block; }
.publish-time { font-size: 24rpx; color: #999999; margin-top: 4rpx; display: block; }

.case-text {
  font-size: 30rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.case-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
