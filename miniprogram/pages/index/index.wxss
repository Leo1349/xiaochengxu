/* pages/index/index.wxss - 智伴优程首页柔和精致风格 */

.container {
  padding: 0;
  min-height: 100vh;
  background-color: #FFF9F5;
  padding-bottom: 160rpx;
}

/* ==================== 顶部搜索区域 ==================== */

.header {
  padding: 28rpx 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF9F5 100%);
}

.search-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
  background-color: #F8F6F3;
  border-radius: 44rpx;
  transition: all 0.25s ease;
  border: 2rpx solid transparent;
}

.search-bar:active {
  background-color: #FFFFFF;
  border-color: #FFAB91;
  box-shadow: 0 0 0 4rpx rgba(255, 171, 145, 0.15);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-placeholder {
  font-size: 28rpx;
  color: #A8A5A2;
}

.role-switch {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #FFE8E4 0%, #FFF5F0 100%);
  color: #FF8066;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  border: 1rpx solid rgba(255, 128, 102, 0.2);
}

.role-switch:active {
  transform: scale(0.97);
}

.switch-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
}

/* ==================== 公告栏 ==================== */

.notice-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 32rpx 0;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE8DC 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 183, 77, 0.3);
}

.notice-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #F57C00;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ==================== 轮播图 ==================== */

.banner {
  margin: 28rpx 32rpx 0;
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(61, 58, 56, 0.1);
}

.banner-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 轮播指示点 */
.banner .wx-swiper-dot {
  width: 10rpx;
  height: 10rpx;
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  margin: 0 8rpx;
  transition: all 0.3s;
}

.banner .wx-swiper-dot-active {
  width: 28rpx;
  background-color: #FF8066;
  border-radius: 5rpx;
}

/* ==================== 功能入口 ==================== */

.menu-section {
  margin: 28rpx 32rpx 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
}

.menu-item {
  width: 25%;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.menu-item:active {
  transform: scale(0.93);
}

.menu-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 14rpx;
  transition: transform 0.25s ease;
}

.menu-item:active .menu-icon {
  transform: translateY(-6rpx);
}

.menu-name {
  font-size: 24rpx;
  color: #3D3A38;
  font-weight: 500;
}

/* ==================== 服务类型 ==================== */

.service-section {
  margin: 28rpx 32rpx 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3D3A38;
  position: relative;
  padding-left: 20rpx;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 3rpx;
}

.view-more {
  font-size: 24rpx;
  color: #A8A5A2;
  transition: color 0.2s ease;
}

.view-more:active {
  color: #FF8066;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx 28rpx;
}

.service-item {
  width: 25%;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.service-item:active {
  transform: scale(0.93);
}

.service-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 14rpx;
  transition: transform 0.25s ease;
}

.service-item:active .service-icon {
  transform: translateY(-6rpx);
}

.service-name {
  font-size: 24rpx;
  color: #3D3A38;
  font-weight: 500;
}

/* ==================== 推荐陪伴师 ==================== */

.teacher-section {
  margin: 28rpx 32rpx 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.teacher-list {
  padding: 0 28rpx 28rpx;
}

.teacher-card {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F3F0;
  transition: all 0.25s ease;
}

.teacher-card:last-child {
  border-bottom: none;
}

.teacher-card:active {
  transform: scale(0.99);
  background-color: #FFFAF8;
}

.teacher-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  background-color: #FFE8E4;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 128, 102, 0.15);
}

.teacher-info {
  flex: 1;
  min-width: 0;
}

.teacher-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.teacher-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3A38;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.teacher-title {
  font-size: 22rpx;
  color: #2E7D6B;
  padding: 6rpx 14rpx;
  background-color: #E0F2EE;
  border-radius: 12rpx;
  font-weight: 500;
}

.teacher-rating {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.rating-score {
  font-size: 26rpx;
  color: #FFB74D;
  font-weight: 600;
}

.order-count {
  font-size: 24rpx;
  color: #A8A5A2;
}

.teacher-tags {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  border-radius: 16rpx;
  background-color: #F8F6F3;
  color: #7A7673;
  font-weight: 500;
}

.teacher-intro {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #7A7673;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.teacher-price {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-start;
  flex-shrink: 0;
}

.price-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8066;
}

.price-unit {
  font-size: 22rpx;
  color: #A8A5A2;
  margin-top: 4rpx;
}

/* ==================== 陪伴师模式欢迎 ==================== */

.teacher-welcome {
  margin: 48rpx 32rpx 0;
  padding: 48rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(255, 128, 102, 0.3);
  position: relative;
  overflow: hidden;
}

/* 装饰圆圈 */
.teacher-welcome::before,
.teacher-welcome::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.teacher-welcome::before {
  width: 200rpx;
  height: 200rpx;
  top: -60rpx;
  right: -40rpx;
}

.teacher-welcome::after {
  width: 140rpx;
  height: 140rpx;
  bottom: -40rpx;
  left: 20%;
}

.welcome-image {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.welcome-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}

.welcome-btn {
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #FFFFFF;
  color: #FF8066;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 1;
  transition: transform 0.2s ease;
}

.welcome-btn:active {
  transform: scale(0.96);
}

/* ==================== 加载状态 ==================== */

.loading {
  text-align: center;
  padding: 48rpx;
  color: #A8A5A2;
  font-size: 26rpx;
}
