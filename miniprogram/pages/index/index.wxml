<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部搜索栏 -->
  <view class="header">
    <view class="search-bar" bindtap="goToSearch">
      <image class="search-icon" src="/images/icons_v3/search_icon.png" mode="aspectFit"></image>
      <text class="search-placeholder">搜索陪伴师</text>
    </view>
  </view>

  <!-- 公告栏 -->
  <view class="notice-bar" wx:if="{{notice}}">
    <image class="notice-icon" src="/images/icons_v3/notice_icon.png" mode="aspectFit"></image>
    <view class="notice-content">
      <text class="notice-text">{{notice}}</text>
    </view>
  </view>

  <!-- 轮播图 -->
  <swiper class="banner" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" circular="{{true}}">
    <swiper-item wx:for="{{bannerList}}" wx:key="id">
      <image class="banner-image" src="{{item.image}}" mode="aspectFill" data-url="{{item.url}}" bindtap="onBannerTap"></image>
    </swiper-item>
  </swiper>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="menu-grid">
      <view class="menu-item" wx:for="{{menuList}}" wx:key="id" data-url="{{item.url}}" bindtap="goToMenu">
        <image class="menu-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="menu-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 服务类型 -->
  <view class="service-section">
    <view class="section-header">
      <text class="section-title">服务类型</text>
    </view>
    <view class="service-grid">
      <view class="service-item" wx:for="{{serviceTypes}}" wx:key="id" data-id="{{item.id}}" bindtap="goToServiceType">
        <image class="service-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="service-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 推荐陪伴师 -->
  <view class="teacher-section">
    <view class="section-header">
      <text class="section-title">推荐陪伴师</text>
      <text class="view-more" bindtap="viewMoreTeachers">查看更多 ></text>
    </view>
    
    <view class="teacher-list" wx:if="{{!loading}}">
      <view class="teacher-card" wx:for="{{teacherList}}" wx:key="id" data-id="{{item.id}}" bindtap="goToTeacherDetail">
        <image class="teacher-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view class="teacher-info">
          <view class="teacher-name-row">
            <text class="teacher-name">{{item.name}}</text>
          </view>
          <view class="teacher-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <text class="teacher-intro">{{item.introduction}}</text>
        </view>
        <view class="teacher-price">
          <text class="price-value">¥{{item.price}}</text>
          <text class="price-unit">/小时</text>
        </view>
      </view>
    </view>
    
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>


  <privacy-popup />
</view>
