.container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #F7F8FA;
}

.login-box {
  width: 80%;
  background: #fff;
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 60rpx;
}

.password-input {
  width: 100%;
  height: 88rpx;
  background: #F5F7FA;
  border-radius: 44rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: #4080FF;
  color: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.login-btn::after {
  border: none;
}
