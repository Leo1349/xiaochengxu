/* pages/admin/login/index.wxss - TDesign 风格管理员登录样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1A1A2E 0%, #16213E 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
}

.login-box {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.3);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  text-align: center;
  margin-bottom: 48rpx;
}

.password-input {
  width: 100%;
  height: 100rpx;
  padding: 0 32rpx;
  background-color: #F5F6F8;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 32rpx;
}

.password-input::placeholder { color: #999999; }

.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 16rpx;
  padding-left: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4);
}

.login-btn:active { opacity: 0.9; transform: scale(0.98); }
