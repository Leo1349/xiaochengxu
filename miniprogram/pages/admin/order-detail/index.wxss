/* pages/admin/order-detail/index.wxss - TDesign 风格管理后台订单详情样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding: 24rpx;
  padding-bottom: 180rpx;
}

/* ==================== 状态卡片 ==================== */

.status-card {
  padding: 40rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.status-pending { background: linear-gradient(135deg, #FF8F1F 0%, #D16A1C 100%); }
.status-confirmed { background: linear-gradient(135deg, #3D7EFF 0%, #0052D9 100%); }
.status-ongoing { background: linear-gradient(135deg, #17A2B8 0%, #138496 100%); }
.status-completed { background: linear-gradient(135deg, #00B578 0%, #008A5D 100%); }
.status-cancelled { background: linear-gradient(135deg, #6C757D 0%, #5A6268 100%); }

.status-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.status-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  display: block;
}

/* ==================== 信息区块 ==================== */

.section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  overflow: hidden;
}

.section-title {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  background-color: #F9FAFC;
  border-bottom: 1rpx solid #F0F0F0;
}

.info-item {
  display: flex;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.info-item:last-child { border-bottom: none; }

.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #999999;
  flex-shrink: 0;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  word-break: break-all;
}

.openid {
  font-size: 24rpx;
  color: #666666;
}

.price {
  font-weight: 600;
  color: #FF3B30;
  font-size: 32rpx;
}

/* ==================== 底部操作栏 ==================== */

.footer-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 40rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn:active { transform: scale(0.98); }

.btn-confirm {
  background: linear-gradient(135deg, #3D7EFF 0%, #0052D9 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.3);
}

.btn-start {
  background: linear-gradient(135deg, #17A2B8 0%, #138496 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(23, 162, 184, 0.3);
}

.btn-complete {
  background: linear-gradient(135deg, #00B578 0%, #008A5D 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 168, 112, 0.3);
}

.btn-cancel {
  background-color: #F5F6F8;
  color: #666666;
}

.btn-cancel:active { background-color: #E0E0E0; }
