.container {
  padding-bottom: 120rpx;
  background-color: #F7F8FA;
  min-height: 100vh;
}

.status-card {
  padding: 40rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.status-text {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #666;
}

.status-pending .status-text { color: #FF9800; }
.status-confirmed .status-text { color: #4080FF; }
.status-completed .status-text { color: #4CAF50; }
.status-cancelled .status-text { color: #999; }

.section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.info-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  color: #999;
  width: 160rpx;
}

.value {
  flex: 1;
  text-align: right;
  color: #333;
}

.value.price {
  color: #FE2C55;
  font-weight: bold;
}

.value.openid {
  font-size: 24rpx;
}

.footer-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #fff;
}

.btn::after { border: none; }

.btn-confirm { background: #4080FF; }
.btn-start { background: #4080FF; }
.btn-complete { background: #4CAF50; }
.btn-cancel { background: #f5f5f5; color: #666; }
