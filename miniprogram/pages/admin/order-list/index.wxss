/* pages/admin/order-list/index.wxss - TDesign 风格管理后台订单列表样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
}

/* ==================== Tab 标签栏 ==================== */

.tabs {
  display: flex;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  transition: all 0.2s ease;
}

.tab-item.active {
  color: #3D7EFF;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #3D7EFF;
  border-radius: 2rpx;
}

/* ==================== 订单列表 ==================== */

.order-list {
  height: calc(100vh - 100rpx);
  padding: 24rpx;
}

.order-item {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.order-no {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

.status-pending { color: #FF8F1F; background-color: #FFF7E6; }
.status-ongoing { color: #3D7EFF; background-color: #E6F0FF; }
.status-completed { color: #00B578; background-color: #E6FFFB; }
.status-cancelled { color: #999999; background-color: #F5F6F8; }

.order-content { padding: 24rpx 32rpx; }

.info-row {
  display: flex;
  margin-bottom: 16rpx;
}

.info-row:last-child { margin-bottom: 0; }

.label {
  width: 120rpx;
  font-size: 26rpx;
  color: #999999;
}

.value {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.price {
  font-weight: 600;
  color: #FF3B30;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
  background-color: #F9FAFC;
}

.create-time {
  font-size: 24rpx;
  color: #999999;
}

.action-btn {
  height: 56rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #00B578 0%, #008F5D 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn:active { opacity: 0.85; }

/* ==================== 加载/空状态 ==================== */

.loading-more, .no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #999999;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  font-size: 28rpx;
  color: #999999;
}
