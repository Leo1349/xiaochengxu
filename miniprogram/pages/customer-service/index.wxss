/* pages/customer-service/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.contact-section {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.contact-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.contact-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 30rpx;
}

.contact-btns {
  display: flex;
}

.contact-btn {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 28rpx;
}

.faq-section {
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.faq-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.faq-item {
  border-bottom: 1rpx solid #f5f5f5;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.question-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(74, 144, 217, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4a90d9;
  margin-right: 20rpx;
}

.question-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.expand-icon {
  font-size: 28rpx;
  color: #999;
  transition: transform 0.3s;
}

.faq-item.expanded .expand-icon {
  transform: rotate(180deg);
}

.faq-answer {
  padding: 0 30rpx 30rpx 98rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: none;
}

.faq-item.expanded .faq-answer {
  display: block;
}

.category-section {
  padding: 0 30rpx 30rpx;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.icon-emoji {
  font-size: 40rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

.feedback-section {
  padding: 0 30rpx 30rpx;
}

.feedback-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.feedback-content {
  flex: 1;
}

.feedback-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.feedback-desc {
  font-size: 26rpx;
  color: #999;
}

.feedback-btn {
  padding: 16rpx 32rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.work-time {
  padding: 0 30rpx 30rpx;
}

.time-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.time-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.time-icon {
  margin-right: 12rpx;
}

.time-list {
  display: flex;
  flex-direction: column;
}

.time-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.time-label {
  color: #666;
}

.time-value {
  color: #333;
}

