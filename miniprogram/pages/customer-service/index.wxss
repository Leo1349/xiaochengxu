/* pages/customer-service/index.wxss - TDesign 风格客服页样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding: 24rpx;
}

.header { text-align: center; padding: 48rpx 0; }
.service-icon { width: 160rpx; height: 160rpx; margin-bottom: 32rpx; }
.header-title { font-size: 36rpx; font-weight: 700; color: #333333; display: block; }
.header-desc { font-size: 28rpx; color: #666666; margin-top: 16rpx; display: block; }

.contact-section { background-color: #FFFFFF; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02); }

.contact-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.contact-item:last-child { border-bottom: none; }

.contact-icon { width: 56rpx; height: 56rpx; margin-right: 24rpx; background-color: #E6F0FF; border-radius: 12rpx; padding: 16rpx; }
.contact-info { flex: 1; }
.contact-label { font-size: 28rpx; color: #333333; font-weight: 500; display: block; }
.contact-value { font-size: 24rpx; color: #666666; margin-top: 4rpx; display: block; }
.contact-btn { padding: 16rpx 32rpx; background-color: #3D7EFF; color: #FFFFFF; font-size: 24rpx; border-radius: 32rpx; }

.faq-section { background-color: #FFFFFF; border-radius: 16rpx; padding: 32rpx; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02); }
.section-title { font-size: 30rpx; font-weight: 600; color: #333333; margin-bottom: 24rpx; }
.faq-item { padding: 24rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.faq-item:last-child { border-bottom: none; }
.faq-question { font-size: 28rpx; color: #333333; display: block; }
.faq-answer { font-size: 24rpx; color: #666666; margin-top: 16rpx; line-height: 1.5; display: block; }
