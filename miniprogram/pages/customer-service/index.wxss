/* pages/customer-service/index.wxss - TDesign 风格客服页样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding: 24rpx;
}

/* ==================== 客服入口 ==================== */

.service-section {
  margin-bottom: 24rpx;
}

.service-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.service-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.service-logo {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.service-info {
  flex: 1;
}

.service-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
}

.service-time {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  display: block;
}

.service-actions {
  display: flex;
  gap: 24rpx;
}

.service-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  background-color: #F5F6F8;
  color: #333333;
  border: none;
  padding: 0;
  line-height: 1;
}

.service-btn.primary {
  background-color: #3D7EFF;
  color: #FFFFFF;
}

.btn-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

/* ==================== 联系方式 ==================== */

.contact-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.contact-list {
  /* 容器 */
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  display: block;
}

.contact-value {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
  display: block;
}

.contact-action {
  font-size: 24rpx;
  color: #3D7EFF;
  font-weight: 500;
}

/* ==================== 常见问题 ==================== */

.faq-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.faq-list {
  /* 容器 */
}

.faq-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.question-text {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
}

.arrow-icon {
  font-size: 28rpx;
  color: #CCCCCC;
  transition: transform 0.2s;
}

.arrow-icon.rotate {
  transform: rotate(180deg);
}

.faq-answer {
  font-size: 24rpx;
  color: #666666;
  margin-top: 16rpx;
  line-height: 1.6;
  padding: 16rpx;
  background-color: #F9FAFC;
  border-radius: 8rpx;
}

/* ==================== 意见反馈 ==================== */

.feedback-section {
  margin-bottom: 24rpx;
}

.feedback-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.feedback-info {
  display: flex;
  align-items: center;
}

.feedback-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.feedback-text {
  display: flex;
  flex-direction: column;
}

.feedback-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.feedback-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}
