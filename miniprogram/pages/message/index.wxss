/* pages/message/index.wxss */

.container {
  padding: 0;
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 140rpx;
}

/* 顶部标签 */
.tabs {
  display: flex;
  background: #ffffff;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  position: relative;
}

.tab-name {
  font-size: 28rpx;
  color: #666666;
}

.tab-item.active .tab-name {
  color: #4a90d9;
  font-weight: 600;
}

.tab-item.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #4a90d9;
}

.unread-badge {
  position: absolute;
  top: 8rpx;
  right: 30rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 操作栏 */
.action-bar {
  margin: 12rpx 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
}

.action-text {
  font-size: 24rpx;
  color: #4a90d9;
}

/* 列表 */
.message-list {
  padding: 16rpx 24rpx;
}

.message-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}

.message-item.unread {
  border: 1rpx solid rgba(74, 144, 217, 0.25);
  background: rgba(74, 144, 217, 0.04);
}

.message-avatar {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  margin-right: 16rpx;
}

.avatar-img,
.icon-img {
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: #f2f3f5;
}

.unread-dot {
  position: absolute;
  right: 2rpx;
  top: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #ff4d4f;
  border: 3rpx solid #ffffff;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.message-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-time {
  flex: none;
  font-size: 22rpx;
  color: #999999;
}

.message-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-icon {
  margin-left: 10rpx;
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.35);
  line-height: 1;
}

/* 状态 */
.empty-state {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.8;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999999;
}

.loading-more,
.no-more {
  padding: 24rpx 0 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
