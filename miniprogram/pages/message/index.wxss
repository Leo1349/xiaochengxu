/* pages/message/index.wxss - 智伴家消息页柔和精致风格 */

.container {
  min-height: 100vh;
  background-color: #FFF9F5;
}

/* ==================== 顶部标签栏 ==================== */

.tabs {
  display: flex;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F3F0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 28rpx 0;
  position: relative;
}

.tab-name {
  font-size: 30rpx;
  color: #7A7673;
  transition: all 0.25s ease;
  font-weight: 500;
}

.tab-item.active .tab-name {
  color: #FF8066;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 3rpx;
}

.unread-badge {
  position: absolute;
  top: 18rpx;
  right: 50%;
  transform: translateX(44rpx);
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 18rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 128, 102, 0.3);
}

/* ==================== 操作栏 ==================== */

.action-bar {
  padding: 18rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F3F0;
}

.action-text {
  font-size: 24rpx;
  color: #FF8066;
  font-weight: 600;
}

/* ==================== 消息列表 ==================== */

.message-list {
  padding: 20rpx 0;
}

.message-item {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx;
  background-color: #FFFFFF;
  margin-bottom: 2rpx;
  transition: all 0.25s ease;
}

.message-item:active {
  background-color: #FFFAF8;
  transform: scale(0.995);
}

.message-item.unread {
  background: linear-gradient(90deg, #FFE8E4 0%, #FFFFFF 20%);
  border-left: 5rpx solid #FF8066;
}

/* 消息头像/图标 */
.message-avatar {
  position: relative;
  margin-right: 28rpx;
}

.avatar-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background-color: #FFE8E4;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 128, 102, 0.15);
}

.icon-img {
  width: 104rpx;
  height: 104rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #FFE8E4 0%, #FFF5F0 100%);
  border-radius: 24rpx;
}

.unread-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 18rpx;
  height: 18rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255, 128, 102, 0.4);
  }
  50% {
    transform: scale(1.1);
    box-shadow: 0 0 0 8rpx rgba(255, 128, 102, 0);
  }
}

/* 消息内容 */
.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.message-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3A38;
}

.message-time {
  font-size: 22rpx;
  color: #A8A5A2;
}

.message-text {
  font-size: 26rpx;
  color: #7A7673;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.arrow-icon {
  font-size: 36rpx;
  color: #CCCCCC;
  margin-left: 20rpx;
}

/* ==================== 空状态 ==================== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx;
}

.empty-icon {
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 36rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #A8A5A2;
}

/* ==================== 加载状态 ==================== */

.loading-more, .no-more {
  text-align: center;
  padding: 36rpx;
  font-size: 24rpx;
  color: #CCCCCC;
}
