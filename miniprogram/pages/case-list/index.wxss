/* pages/case-list/index.wxss - TDesign 风格案例列表样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding: 24rpx;
}

.case-list { display: flex; flex-direction: column; gap: 24rpx; }

.case-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  transition: all 0.2s ease;
}

.case-card:active { transform: scale(0.98); box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05); }

.case-cover { width: 100%; height: 280rpx; background-color: #F9FAFC; }

.case-info { padding: 24rpx; }

.case-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

.case-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.case-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.case-author { display: flex; align-items: center; }
.author-avatar { width: 48rpx; height: 48rpx; border-radius: 50%; margin-right: 16rpx; background-color: #F9FAFC; }
.author-name { font-size: 24rpx; color: #666666; }
.case-stats { font-size: 24rpx; color: #999999; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { width: 200rpx; height: 200rpx; margin-bottom: 32rpx; opacity: 0.5; }
.empty-text { font-size: 28rpx; color: #999999; }
.loading-more, .no-more { text-align: center; padding: 32rpx; font-size: 24rpx; color: #999999; }
