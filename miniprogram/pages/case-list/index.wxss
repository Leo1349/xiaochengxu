/* pages/case-list/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.filter-bar {
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.filter-item.active {
  background: rgba(74, 144, 217, 0.1);
  color: #4a90d9;
}

.filter-arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
}

.case-list {
  padding: 20rpx 30rpx;
}

.case-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.case-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.teacher-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.teacher-info {
  flex: 1;
}

.teacher-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.teacher-title {
  font-size: 24rpx;
  color: #999;
}

.case-tag {
  padding: 8rpx 20rpx;
  background: rgba(74, 144, 217, 0.1);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #4a90d9;
}

.case-content {
  padding: 24rpx 30rpx;
}

.case-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.case-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.case-stats {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f5f5f5;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 24rpx;
  color: #999;
}

.stat-icon {
  margin-right: 8rpx;
}

.case-images {
  display: flex;
  padding: 0 30rpx 24rpx;
}

.case-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.case-result {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: rgba(82, 196, 26, 0.1);
  margin: 0 30rpx 24rpx;
  border-radius: 12rpx;
}

.result-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.result-text {
  font-size: 26rpx;
  color: #52c41a;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* ===== 以下为与 pages/case-list/index.wxml 对齐的样式（补齐/覆盖）===== */

.container {
  padding: 0;
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 140rpx;
}

.category-scroll {
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.category-list {
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx;
  white-space: nowrap;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  font-size: 26rpx;
  color: #666666;
}

.category-item.active {
  background: rgba(74, 144, 217, 0.12);
  color: #4a90d9;
  font-weight: 700;
}

.case-list {
  padding: 16rpx 24rpx;
}

.case-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.case-cover {
  width: 100%;
  height: 320rpx;
  background: #f2f3f5;
}

.case-content {
  padding: 18rpx;
}

.case-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #333333;
}

.case-summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.case-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
}

.teacher-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.teacher-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #f2f3f5;
}

.teacher-name {
  font-size: 24rpx;
  color: #333333;
}

.case-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999999;
  margin-right: 0;
}

.stat-icon {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.04);
  color: #666666;
}

.stat-value {
  color: #999999;
}

.empty-state {
  padding: 120rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 16rpx;
  opacity: 0.9;
}
