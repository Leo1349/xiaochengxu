  font-size: 24rpx;
  color: #999999;
}

.certificate-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.certificate-item {
  width: 48%;
  background: #f2f3f5;
  border-radius: 12rpx;
