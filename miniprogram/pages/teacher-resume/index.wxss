/* pages/teacher-resume/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.progress-bar {
  display: flex;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.progress-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.progress-step::after {
  content: "";
  position: absolute;
  top: 20rpx;
  right: -50%;
  width: 100%;
  height: 4rpx;
  background: #eee;
}

.progress-step:last-child::after {
  display: none;
}

.progress-step.active::after {
  background: #4a90d9;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  position: relative;
  z-index: 1;
  margin-bottom: 12rpx;
}

.progress-step.active .step-dot {
  background: #4a90d9;
  color: #fff;
}

.progress-step.completed .step-dot {
  background: #52c41a;
  color: #fff;
}

.step-text {
  font-size: 24rpx;
  color: #999;
}

.progress-step.active .step-text {
  color: #4a90d9;
  font-weight: bold;
}

.section {
  background: #fff;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #ff4444;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.picker-placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

.avatar-uploader {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.avatar-placeholder {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  border: 2rpx dashed #ddd;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.change-btn {
  font-size: 26rpx;
  color: #4a90d9;
}

.tag-selector {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.tag-item.active {
  background: rgba(74, 144, 217, 0.1);
  border-color: #4a90d9;
  color: #4a90d9;
}

.cert-list {
  display: flex;
  flex-wrap: wrap;
}

.cert-item {
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.cert-image {
  width: 100%;
  height: 100%;
}

.cert-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

.cert-add {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.service-list {
  display: flex;
  flex-direction: column;
}

.service-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.service-item:last-child {
  border-bottom: none;
}

.service-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.service-price-input {
  width: 200rpx;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  text-align: right;
}

.service-unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.prev-btn {
  flex: 1;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.next-btn {
  flex: 1;
  height: 88rpx;
  background: #4a90d9;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn {
  flex: 1;
  height: 88rpx;
  background: #52c41a;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 以下为与 pages/teacher-resume/index.wxml 对齐的样式（补齐/覆盖）===== */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 160rpx;
}

.status-bar {
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  color: #ffffff;
}

.status-bar.pending {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
}

.status-bar.approved {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.status-bar.rejected {
  background: linear-gradient(135deg, #ff4d4f 0%, #cf1322 100%);
}

.status-text {
  font-size: 28rpx;
  font-weight: 800;
}

.reject-reason {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.95;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #333333;
}

.add-btn {
  font-size: 24rpx;
  color: #4a90d9;
}

.photo-count {
  font-size: 24rpx;
  color: #999999;
}

.avatar-section {
