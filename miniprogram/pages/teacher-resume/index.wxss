/* pages/teacher-resume/index.wxss - TDesign 风格教师简历样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 32rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #3D7EFF;
}

/* 头像上传 */
.avatar-section { text-align: center; padding: 32rpx 0; }
.avatar-wrapper { display: inline-block; position: relative; }
.avatar { width: 160rpx; height: 160rpx; border-radius: 50%; background-color: #E6F0FF; border: 4rpx solid #F0F0F0; }
.avatar-edit { position: absolute; bottom: 0; right: 0; width: 48rpx; height: 48rpx; background-color: #3D7EFF; border-radius: 50%; display: flex; justify-content: center; align-items: center; }
.avatar-edit image { width: 28rpx; height: 28rpx; }
.avatar-tip { font-size: 24rpx; color: #999999; margin-top: 16rpx; display: block; }

/* 表单项 */
.form-item { margin-bottom: 32rpx; }
.form-label { font-size: 28rpx; color: #666666; margin-bottom: 16rpx; display: block; }
.form-label.required::before { content: '*'; color: #FF3B30; margin-right: 4rpx; }
.form-input { height: 88rpx; padding: 0 24rpx; background-color: #F9FAFC; border-radius: 12rpx; font-size: 28rpx; color: #333333; }
.form-textarea { width: 100%; height: 200rpx; padding: 24rpx; background-color: #F9FAFC; border-radius: 12rpx; font-size: 28rpx; }
.picker-value { display: flex; justify-content: space-between; align-items: center; height: 88rpx; padding: 0 24rpx; background-color: #F9FAFC; border-radius: 12rpx; font-size: 28rpx; color: #333333; }
.arrow-icon { font-size: 32rpx; color: #CCCCCC; }

/* 标签选择 */
.tag-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag-item { padding: 16rpx 24rpx; background-color: #F9FAFC; color: #666666; font-size: 24rpx; border-radius: 32rpx; border: 2rpx solid transparent; }
.tag-item.active { background-color: #E6F0FF; color: #3D7EFF; border-color: #3D7EFF; }

/* 证书上传 */
.cert-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cert-item { position: relative; width: 180rpx; height: 180rpx; border-radius: 12rpx; overflow: hidden; }
.cert-image { width: 100%; height: 100%; }
.cert-delete { position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; background-color: rgba(0, 0, 0, 0.5); border-radius: 50%; display: flex; justify-content: center; align-items: center; }
.add-cert { width: 180rpx; height: 180rpx; background-color: #F9FAFC; border: 2rpx dashed #E0E0E0; border-radius: 12rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.add-icon { font-size: 48rpx; color: #CCCCCC; }
.add-text { font-size: 24rpx; color: #999999; margin-top: 8rpx; }

/* 底部按钮 */
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 24rpx 32rpx; background-color: #FFFFFF; box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05); }
.submit-btn { height: 96rpx; background: linear-gradient(135deg, #3D7EFF 0%, #0052D9 100%); color: #FFFFFF; font-size: 32rpx; font-weight: 600; border-radius: 48rpx; box-shadow: 0 8rpx 24rpx rgba(61, 126, 255, 0.3); display: flex; align-items: center; justify-content: center; }
