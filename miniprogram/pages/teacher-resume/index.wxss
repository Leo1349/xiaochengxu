.work-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.work-item {
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 14rpx;
}

.work-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.work-company {
  font-size: 26rpx;
  color: #333333;
  font-weight: 700;
}

.work-actions {
  display: flex;
  gap: 10rpx;
}

.action-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.9;
}

.work-position {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.work-date {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.work-description {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #666666;
  line-height: 1.6;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-item {
  width: 31.5%;
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background: #f2f3f5;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-item .delete-icon {
  width: 34rpx;
  height: 34rpx;
  right: 8rpx;
  top: 8rpx;
}

.photo-add {
  width: 31.5%;
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  background: #f2f3f5;
  border: 2rpx dashed rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 44rpx;
  color: rgba(0, 0, 0, 0.35);
  line-height: 1;
}

.add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 18rpx 24rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.save-btn {
  height: 84rpx;
  border-radius: 42rpx;
  background: #4a90d9;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 998;
}

.modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  transform: translateY(105%);
  transition: transform 0.25s ease;
  z-index: 999;
}

.modal.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.modal-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #333333;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
}

.modal-content {
  max-height: 60vh;
  overflow: auto;
  padding: 18rpx;
}

.modal-footer {
  display: flex;
  gap: 12rpx;
  padding: 18rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-btn {
  background: #f2f3f5;
  color: #666666;
}

.confirm-btn {
  background: #4a90d9;
  color: #ffffff;
}
