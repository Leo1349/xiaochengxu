/* pages/register/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx 30rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.required {
  color: #ff4444;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.code-input-group {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.code-btn {
  margin-left: 20rpx;
  padding: 0 32rpx;
  height: 88rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.code-btn.disabled {
  background: #ccc;
}

.role-selector {
  display: flex;
  gap: 30rpx;
}

.role-item {
  flex: 1;
  padding: 30rpx 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.role-item.active {
  background: rgba(74, 144, 217, 0.1);
  border-color: #4a90d9;
}

.role-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.role-desc {
  font-size: 24rpx;
  color: #999;
}

.picker-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

.agreement-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #4a90d9;
  border-color: #4a90d9;
}

.check-icon {
  font-size: 24rpx;
  color: #fff;
}

.agreement-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.agreement-link {
  color: #4a90d9;
}

.register-btn {
  width: 100%;
  height: 96rpx;
  background: #4a90d9;
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.register-btn.disabled {
  background: #ccc;
}

.login-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.link-text {
  color: #4a90d9;
}
