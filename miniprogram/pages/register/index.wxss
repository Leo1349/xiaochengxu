/* pages/register/index.wxss - TDesign 风格注册页样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E6F0FF 0%, #F5F6F8 50%);
  padding: 32rpx;
}

/* ==================== Logo 区域 ==================== */

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}

/* ==================== 角色选择 ==================== */

.role-tabs {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.role-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.role-item.active {
  border-color: #3D7EFF;
  background-color: #E6F0FF;
}

.role-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.role-item text:nth-child(2) {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.role-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* ==================== 注册表单 ==================== */

.register-form {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.form-item { margin-bottom: 32rpx; }

.input-wrapper {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  background-color: #F9FAFC;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.input-wrapper:focus-within {
  border-color: #3D7EFF;
  background-color: #FFFFFF;
}

.input-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
  opacity: 0.6;
}

.input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #333333;
}

.code-input { flex: 1; }

.code-btn {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #3D7EFF;
  font-weight: 500;
  border-left: 1rpx solid #E0E0E0;
  margin-left: 24rpx;
}

.code-btn.disabled { color: #CCCCCC; }

.register-btn {
  margin-top: 24rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #3D7EFF 0%, #0052D9 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(61, 126, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.register-btn:active { opacity: 0.9; }

/* ==================== 用户协议 ==================== */

.agreement-section {
  display: flex;
  align-items: flex-start;
  margin-top: 32rpx;
  padding: 0 16rpx;
}

.agreement-check { padding: 8rpx; }

.check-icon {
  width: 36rpx;
  height: 36rpx;
}

.agreement-text {
  flex: 1;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

.agreement-text .link { color: #3D7EFF; }

/* ==================== 其他入口 ==================== */

.other-entry {
  text-align: center;
  padding: 32rpx;
}

.login-link {
  font-size: 28rpx;
  color: #3D7EFF;
}

/* ==================== 陪伴师提示 ==================== */

.teacher-tips {
  margin-top: 32rpx;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.tips-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 24rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}
