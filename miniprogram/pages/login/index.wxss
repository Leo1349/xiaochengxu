/* pages/login/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #fff;
  padding: 0 50rpx;
  display: flex;
  flex-direction: column;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 60rpx;
}

.logo-wrap {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.app-slogan {
  font-size: 28rpx;
  color: #999;
}

.login-form {
  flex: 1;
}

.input-group {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  padding: 30rpx 0;
}

.input-prefix {
  font-size: 32rpx;
  color: #333;
  margin-right: 20rpx;
}

.input-group input {
  flex: 1;
  font-size: 32rpx;
}

.code-btn {
  padding: 16rpx 24rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.code-btn.disabled {
  background: #ccc;
}

.login-btn {
  margin-top: 60rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
}

.wx-login-section {
  margin-top: 60rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.divider .line {
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider-text {
  padding: 0 20rpx;
  color: #999;
  font-size: 26rpx;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  height: 96rpx;
}

.wx-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  padding: 40rpx 0;
}

.checkbox-wrap {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #fff;
}

.checkbox.checked {
  background: #4a90d9;
  border-color: #4a90d9;
}

.agreement-text {
  font-size: 24rpx;
  color: #999;
}

.agreement-link {
  font-size: 24rpx;
  color: #4a90d9;
}

.register-entry {
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
}

.register-link {
  color: #4a90d9;
}

.placeholder {
  color: #ccc;
}
