/* pages/login/index.wxss - 智伴优程登录页柔和精致风格 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF9F5 40%, #FFE8E4 100%);
  padding: 36rpx;
  display: flex;
  flex-direction: column;
}

/* ==================== Logo 区域 ==================== */

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 72rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 36rpx;
  border-radius: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 128, 102, 0.25);
}

.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #3D3A38;
  margin-bottom: 12rpx;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.app-slogan {
  font-size: 28rpx;
  color: #7A7673;
}

/* ==================== 登录方式切换 ==================== */

.login-tabs {
  display: flex;
  background-color: #F8F6F3;
  border-radius: 44rpx;
  padding: 8rpx;
  margin-bottom: 44rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #7A7673;
  border-radius: 36rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  font-weight: 500;
}

.tab-item.active {
  background-color: #FFFFFF;
  color: #FF8066;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(61, 58, 56, 0.08);
}

/* ==================== 登录表单 ==================== */

.login-form {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(61, 58, 56, 0.06);
}

.form-item {
  margin-bottom: 36rpx;
}

.form-item:last-of-type {
  margin-bottom: 0;
}

.input-wrapper {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 28rpx;
  background-color: #F8F6F3;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.input-wrapper:focus-within {
  border-color: #FFAB91;
  background-color: #FFFFFF;
  box-shadow: 0 0 0 6rpx rgba(255, 171, 145, 0.12);
}

.input-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  opacity: 0.5;
}

.input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #3D3A38;
}

.input::placeholder {
  color: #A8A5A2;
}

.code-input {
  flex: 1;
}

.code-btn {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: #FF8066;
  font-weight: 600;
  border-left: 1rpx solid #E8E5E2;
  margin-left: 24rpx;
  transition: all 0.2s ease;
}

.code-btn:active {
  opacity: 0.7;
}

.code-btn.disabled {
  color: #CCCCCC;
}

.login-btn {
  margin-top: 48rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 52rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 128, 102, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.login-btn:active {
  transform: scale(0.97);
  box-shadow: 0 8rpx 24rpx rgba(255, 128, 102, 0.25);
}

/* ==================== 微信登录 ==================== */

.wechat-login {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(61, 58, 56, 0.06);
}

.wechat-tips {
  text-align: center;
  margin-bottom: 44rpx;
}

.wechat-tips text {
  font-size: 28rpx;
  color: #7A7673;
}

.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 52rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.35);
  transition: all 0.2s ease;
}

.wechat-btn:active {
  transform: scale(0.97);
}

.wechat-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
}

.phone-auth-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  background-color: #F8F6F3;
  color: #3D3A38;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 52rpx;
  transition: all 0.2s ease;
}

.phone-auth-btn:active {
  background-color: #E8E5E2;
}

.phone-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

/* ==================== 用户协议 ==================== */

.agreement-section {
  display: flex;
  align-items: center;
  margin-top: 44rpx;
  padding: 0 20rpx;
  background: transparent;
}

.agreement-check {
  padding: 0;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.check-icon {
  width: 36rpx;
  height: 36rpx;
}

.agreement-text {
  flex: 1;
  font-size: 24rpx;
  color: #7A7673;
  line-height: 36rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.agreement-text .link {
  color: #FF8066;
  font-weight: 500;
}

/* ==================== 其他入口 ==================== */

.other-entry {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 100rpx;
}

.register-link {
  font-size: 28rpx;
  color: #FF8066;
  font-weight: 600;
}
