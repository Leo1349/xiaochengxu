/* pages/feedback-list/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.feedback-list {
  padding-bottom: 40rpx;
}

.feedback-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status.pending {
  color: #ff9900;
  background: #fff7e6;
}

.status.processing {
  color: #1890ff;
  background: #e6f7ff;
}

.status.resolved {
  color: #52c41a;
  background: #f6ffed;
}

.content {
  margin-bottom: 20rpx;
}

.type-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #666;
  background: #f0f0f0;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  vertical-align: middle;
}

.text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  vertical-align: middle;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.images image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #eee;
}

.loading, .no-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
}

.empty-state {
  padding-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  color: #999;
  font-size: 28rpx;
}
