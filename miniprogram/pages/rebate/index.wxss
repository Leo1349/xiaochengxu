/* pages/rebate/index.wxss - TDesign 风格返利页样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
}

.header-card {
  background: linear-gradient(135deg, #3D7EFF 0%, #0052D9 100%);
  padding: 48rpx 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.header-card::before, .header-card::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.header-card::before { width: 200rpx; height: 200rpx; top: -60rpx; right: -40rpx; }
.header-card::after { width: 120rpx; height: 120rpx; bottom: -30rpx; left: 10%; }

.balance-label { font-size: 28rpx; color: rgba(255, 255, 255, 0.8); margin-bottom: 16rpx; position: relative; z-index: 1; }
.balance-value { font-size: 80rpx; font-weight: 700; color: #FFFFFF; position: relative; z-index: 1; }
.balance-unit { font-size: 32rpx; }

.action-btns { display: flex; gap: 24rpx; padding: 32rpx; margin-top: -40rpx; position: relative; z-index: 1; }
.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.withdraw-btn { background-color: #FFFFFF; color: #3D7EFF; }
.record-btn { background: linear-gradient(135deg, #FF8F1F 0%, #D16A1C 100%); color: #FFFFFF; }

.section {
  margin: 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.section-title { font-size: 30rpx; font-weight: 600; color: #333333; margin-bottom: 24rpx; }

.stat-grid { display: flex; }
.stat-item { flex: 1; text-align: center; }
.stat-value { font-size: 36rpx; font-weight: 700; color: #333333; display: block; }
.stat-label { font-size: 24rpx; color: #999999; margin-top: 8rpx; display: block; }

.record-list { margin-top: 24rpx; }
.record-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.record-item:last-child { border-bottom: none; }
.record-info { flex: 1; }
.record-title { font-size: 28rpx; color: #333333; display: block; }
.record-time { font-size: 24rpx; color: #999999; margin-top: 4rpx; display: block; }
.record-amount { font-size: 30rpx; font-weight: 600; }
.record-amount.income { color: #00B578; }
.record-amount.expense { color: #FF3B30; }

.empty-state { text-align: center; padding: 48rpx; color: #999999; font-size: 28rpx; }
