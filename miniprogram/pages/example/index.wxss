/* pages/example/index.wxss - TDesign 风格示例页样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding: 24rpx;
}

.section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #3D7EFF;
}

.example-list { display: flex; flex-direction: column; gap: 24rpx; }

.example-item {
  background-color: #F9FAFC;
  border-radius: 12rpx;
  padding: 24rpx;
  transition: all 0.2s ease;
}

.example-item:active { background-color: #F0F0F0; }

.example-title { font-size: 28rpx; font-weight: 500; color: #333333; margin-bottom: 16rpx; display: block; }
.example-desc { font-size: 24rpx; color: #666666; line-height: 1.5; }

.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.grid-image { width: calc(33.33% - 12rpx); aspect-ratio: 1; border-radius: 12rpx; background-color: #E6F0FF; }

.btn-list { display: flex; flex-direction: column; gap: 16rpx; }
.demo-btn { height: 80rpx; font-size: 28rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; }
.demo-btn.primary { background: linear-gradient(135deg, #3D7EFF 0%, #0052D9 100%); color: #FFFFFF; }
.demo-btn.outline { background-color: transparent; border: 2rpx solid #3D7EFF; color: #3D7EFF; }
.demo-btn.ghost { background-color: #E6F0FF; color: #666666; }