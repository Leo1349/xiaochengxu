<!--pages/order-list/index.wxml-->
<view class="container">
  <!-- 订单状态Tab -->
  <scroll-view class="tabs-scroll" scroll-x="{{true}}">
    <view class="tabs">
      <view class="tab-item {{currentTab === item.id ? 'active' : ''}}" 
            wx:for="{{tabs}}" 
            wx:key="id" 
            data-tab="{{item.id}}" 
            bindtap="switchTab">
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view class="order-card" wx:for="{{orderList}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="order-header" data-id="{{item.id}}" bindtap="viewOrderDetail">
        <text class="order-id">订单号：{{item.id}}</text>
        <text class="order-status {{item.status}}">{{item.statusText}}</text>
      </view>
      
      <!-- 订单内容 -->
      <view class="order-content" data-id="{{item.id}}" bindtap="viewOrderDetail">
        <!-- 陪伴师信息 -->
        <view class="teacher-row">
          <image class="teacher-avatar" src="{{item.teacher.avatar}}" mode="aspectFill"></image>
          <view class="teacher-info">
            <text class="teacher-name">{{item.teacher.name}}</text>
            <text class="service-name">{{item.service.name}}</text>
          </view>
        </view>
        
        <!-- 服务信息 -->
        <view class="service-info">
          <view class="info-row">
            <text class="info-label">服务孩子</text>
            <text class="info-value">{{item.child.name}}（{{item.child.age}}岁）</text>
          </view>
          <view class="info-row">
            <text class="info-label">服务时间</text>
            <text class="info-value">{{item.serviceDate}} {{item.serviceTime}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">服务时长</text>
            <text class="info-value">{{item.duration}}小时</text>
          </view>
        </view>
        
        <!-- 取消原因 -->
        <view class="cancel-reason" wx:if="{{item.status === 'cancelled' && item.cancelReason}}">
          <text>取消原因：{{item.cancelReason}}</text>
        </view>
      </view>
      
      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-price">
          <text class="price-label">订单金额：</text>
          <text class="price-value">¥{{item.totalPrice}}</text>
        </view>
        
        <!-- 操作按钮 -->
        <view class="order-actions">
          <!-- 家长端操作 -->
          <block wx:if="{{currentRole === 'parent'}}">
            <button class="action-btn default" wx:if="{{item.status === 'pending'}}" data-id="{{item.id}}" catchtap="cancelOrder">取消订单</button>
            <button class="action-btn primary" wx:if="{{item.status === 'pending'}}" data-id="{{item.id}}" catchtap="contactUser">联系客服</button>
            
            <button class="action-btn primary" wx:if="{{item.status === 'confirmed'}}" data-id="{{item.id}}" catchtap="contactUser">联系客服</button>
            
            <button class="action-btn primary" wx:if="{{item.status === 'ongoing'}}" data-id="{{item.id}}" catchtap="contactUser">联系客服</button>
            
            <button class="action-btn default" wx:if="{{item.status === 'completed' && !item.hasReviewed}}" data-id="{{item.id}}" catchtap="goToReview">去评价</button>
            <button class="action-btn primary" wx:if="{{item.status === 'completed'}}" data-id="{{item.id}}" catchtap="reBook">再次预约</button>
            
            <button class="action-btn primary" wx:if="{{item.status === 'cancelled'}}" data-id="{{item.id}}" catchtap="reBook">重新预约</button>
          </block>
          
          <!-- 陪伴师端操作 -->
          <block wx:if="{{currentRole === 'teacher'}}">
            <button class="action-btn default" wx:if="{{item.status === 'pending'}}" data-id="{{item.id}}" catchtap="cancelOrder">拒绝订单</button>
            <button class="action-btn primary" wx:if="{{item.status === 'pending'}}" data-id="{{item.id}}" catchtap="confirmOrder">接受订单</button>
            
            <button class="action-btn default" wx:if="{{item.status === 'confirmed'}}" data-id="{{item.id}}" catchtap="contactUser">联系家长</button>
            <button class="action-btn primary" wx:if="{{item.status === 'confirmed'}}" data-id="{{item.id}}" catchtap="startService">开始服务</button>
            
            <button class="action-btn default" wx:if="{{item.status === 'ongoing'}}" data-id="{{item.id}}" catchtap="contactUser">联系家长</button>
            <button class="action-btn primary" wx:if="{{item.status === 'ongoing'}}" data-id="{{item.id}}" catchtap="completeService">完成服务</button>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{orderList.length === 0 && !loading}}">
    <image class="empty-icon" src="/images/icons/goods.png" mode="aspectFit"></image>
    <text class="empty-text">暂无订单</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && orderList.length > 0}}">
    <text>没有更多订单了</text>
  </view>
</view>
