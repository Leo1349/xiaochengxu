/* pages/order-list/index.wxss - TDesign 风格订单列表样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding-bottom: 60rpx;
}

/* ==================== Tab 标签栏 ==================== */

.tabs-scroll {
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs {
  display: inline-flex;
  white-space: nowrap;
  padding: 0 16rpx;
}

.tab-item {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #3D7EFF;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #3D7EFF;
  border-radius: 3rpx;
}

/* ==================== 订单列表 ==================== */

.order-list { padding: 24rpx; }

.order-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

/* ==================== 订单头部 ==================== */

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.order-id {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

/* 订单状态颜色 */
.order-status.pending {
  color: #FF8F1F;
  background-color: #FFF7E6;
}

.order-status.confirmed {
  color: #3D7EFF;
  background-color: #E6F0FF;
}

.order-status.ongoing {
  color: #00B578;
  background-color: #E6FFFB;
}

.order-status.completed {
  color: #00B578;
  background-color: #E6FFFB;
}

.order-status.cancelled {
  color: #999999;
  background-color: #F5F6F8;
}

/* ==================== 订单内容 ==================== */

.order-content { padding: 24rpx 32rpx; }

.teacher-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.teacher-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background-color: #F5F6F8;
  flex-shrink: 0;
}

.teacher-info {
  flex: 1;
  min-width: 0;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  display: block;
}

.service-name {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #3D7EFF;
  display: block;
}

/* 服务信息 */
.service-info {
  background-color: #F9FAFC;
  border-radius: 12rpx;
  padding: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.info-row:last-child { margin-bottom: 0; }

.info-label {
  font-size: 24rpx;
  color: #999999;
}

.info-value {
  font-size: 24rpx;
  color: #333333;
}

/* 取消原因 */
.cancel-reason {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background-color: #FFF1F0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #FF3B30;
}

/* ==================== 订单底部 ==================== */

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.order-price {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 24rpx;
  color: #999999;
}

.price-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF3B30;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn:active { opacity: 0.8; }

.action-btn.default {
  background-color: #F5F6F8;
  color: #666666;
}

.action-btn.primary {
  background: #3D7EFF;
  color: #FFFFFF;
}

/* ==================== 空状态 ==================== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* ==================== 加载状态 ==================== */

.loading-more, .no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  color: #CCCCCC;
  font-size: 24rpx;
}
