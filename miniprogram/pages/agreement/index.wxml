<!--pages/agreement/index.wxml-->
<view class="container">
  <view class="agreement-content">
    <view class="title">{{title}}</view>
    <view class="time" wx:if="{{updateTime}}">更新日期：{{updateTime}}</view>
    
    <view class="section" wx:for="{{content}}" wx:key="index">
      <view class="sub-title" wx:if="{{item.title}}">{{item.title}}</view>
      <view class="paragraph" wx:for="{{item.paragraphs}}" wx:for-item="para" wx:key="*this">{{para}}</view>
    </view>
  </view>
  
  <view class="footer-action">
    <button class="agree-btn" bindtap="goBack">我已阅读并知晓</button>
  </view>
</view>
