/* pages/agreement/index.wxss */
.container {
  padding: 0;
  background-color: #FFFFFF;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.agreement-content {
  flex: 1;
  padding: 32rpx 32rpx 160rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3D3A38;
  margin-bottom: 20rpx;
  text-align: center;
}

.time {
  font-size: 24rpx;
  color: #A8A5A2;
  text-align: right;
  margin-bottom: 48rpx;
}

.section {
  margin-bottom: 40rpx;
}

.sub-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D3A38;
  margin-bottom: 16rpx;
}

.paragraph {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

.footer-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.agree-btn {
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.agree-btn:active {
  opacity: 0.9;
}
