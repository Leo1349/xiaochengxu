/* pages/search/index.wxss */

.container {
  padding: 0;
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 140rpx;
}

/* 顶部搜索 */
.header {
  padding: 18rpx 24rpx;
  background: #ffffff;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 80rpx;
  border-radius: 40rpx;
  padding: 0 18rpx;
  background: #f2f3f5;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.clear-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.6;
}

.search-btn {
  font-size: 28rpx;
  color: #4a90d9;
  padding: 12rpx 8rpx;
}

/* 首页：历史/热门 */
.search-home {
  padding: 16rpx 24rpx;
}

.history-section,
.hot-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx 18rpx 10rpx;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.delete-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.55;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 10rpx;
}

.tag {
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #f2f3f5;
  color: #666666;
  font-size: 24rpx;
}

.tag.hot {
  background: rgba(74, 144, 217, 0.08);
  color: #4a90d9;
}

/* 结果页 */
.search-result {
  padding: 0;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.filter-item {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14rpx;
  font-size: 26rpx;
  color: #333333;
}

.filter-item.active {
  background: rgba(74, 144, 217, 0.08);
  color: #4a90d9;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  line-height: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #c0c4cc;
  opacity: 0.9;
}

.result-list {
  height: calc(100vh - 88rpx);
  padding: 16rpx 24rpx;
}

.teacher-card {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
}

.teacher-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background: #f2f3f5;
}

.teacher-info {
  flex: 1;
  min-width: 0;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.teacher-title {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #4a90d9;
}

.teacher-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.teacher-tags .tag {
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.teacher-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 22rpx;
  color: #999999;
}

.rating {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #ff9500;
}

.star-icon {
  width: 20rpx;
  height: 20rpx;
}

.teacher-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

.price-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #ff9500;
}

.price-unit {
  font-size: 22rpx;
  color: #999999;
}

.loading-tip,
.no-more {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

.empty-result {
  padding: 90rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 180rpx;
  height: 180rpx;
  opacity: 0.85;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.empty-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 筛选面板 */
.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 99;
}

.filter-panel {
  position: fixed;
  left: 0;
  right: 0;
  top: 160rpx;
  background: #ffffff;
  border-radius: 0 0 18rpx 18rpx;
  transform: translateY(-16rpx);
  opacity: 0;
  pointer-events: none;
  z-index: 100;
}

.filter-panel.show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.filter-options {
  padding: 12rpx 24rpx 24rpx;
}

.option-item {
  padding: 18rpx 14rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  color: #333333;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.option-item.active {
  background: rgba(74, 144, 217, 0.1);
  color: #4a90d9;
  font-weight: 600;
}

.case-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.case-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}
