/* pages/search/index.wxss - TDesign 风格搜索页样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
}

/* ==================== 搜索栏 ==================== */

.search-bar {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #FFFFFF;
  gap: 24rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F5F6F8;
  border-radius: 40rpx;
  transition: all 0.2s ease;
}

.search-input-wrap:focus-within {
  background-color: #FFFFFF;
  box-shadow: 0 0 0 4rpx #E6F0FF;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333333;
}

.search-input::placeholder { color: #999999; }

.clear-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.4;
  margin-left: 16rpx;
}

.search-btn {
  font-size: 28rpx;
  color: #3D7EFF;
  font-weight: 500;
}

/* ==================== 搜索首页 ==================== */

.search-home { padding: 24rpx; }

.history-section,
.hot-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.delete-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.4;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  background-color: #F5F6F8;
  color: #666666;
  border-radius: 32rpx;
  transition: all 0.2s ease;
}

.tag:active { background-color: #E0E0E0; }

.tag.hot {
  background-color: #E6F0FF;
  color: #3D7EFF;
}

/* ==================== 筛选栏 ==================== */

.filter-bar {
  display: flex;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.filter-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666666;
  gap: 8rpx;
}

.filter-item.active { color: #3D7EFF; }

.arrow-icon {
  font-size: 24rpx;
  transition: transform 0.2s ease;
}

.filter-item.active .arrow-icon { transform: rotate(180deg); }

/* ==================== 结果列表 ==================== */

.result-list {
  height: calc(100vh - 180rpx);
  padding: 24rpx;
}

.teacher-card {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  transition: all 0.2s ease;
}

.teacher-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.teacher-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background-color: #F5F6F8;
  flex-shrink: 0;
}

.teacher-info {
  flex: 1;
  min-width: 0;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.teacher-title {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
}

.teacher-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.teacher-tags .tag {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  background-color: #F5F6F8;
  color: #666666;
}

.teacher-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.rating {
  display: flex;
  align-items: center;
  color: #FF8F1F;
  font-weight: 500;
}

.star-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
}

.orders, .distance { color: #999999; }

.teacher-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  margin-left: 16rpx;
}

.price-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF3B30;
}

.price-unit {
  font-size: 22rpx;
  color: #999999;
}

/* ==================== 筛选面板 ==================== */

.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.filter-panel {
  position: fixed;
  top: 220rpx;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  z-index: 101;
  transform: translateY(-100%);
  opacity: 0;
  transition: all 0.3s ease;
}

.filter-panel.show { transform: translateY(0); opacity: 1; }

.filter-options { padding: 24rpx; }

.option-item {
  padding: 24rpx;
  font-size: 28rpx;
  color: #666666;
  border-bottom: 1rpx solid #F0F0F0;
}

.option-item:last-child { border-bottom: none; }

.option-item.active {
  color: #3D7EFF;
  font-weight: 500;
}

/* ==================== 空结果/加载状态 ==================== */

.loading-tip, .no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #999999;
}

.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #CCCCCC;
}
