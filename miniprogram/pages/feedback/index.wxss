/* pages/feedback/index.wxss - 智伴优程反馈页柔和精致风格 */

.top-bar {
  display: flex;
  justify-content: flex-end;
  padding: 0 10rpx 20rpx;
}

.history-link {
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.history-link .arrow {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.container {
  min-height: 100vh;
  background-color: #FFF9F5;
  padding: 28rpx;
  padding-bottom: 100rpx;
}

/* 区块 */
.section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3A38;
  margin-bottom: 28rpx;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.required::before {
  content: '*';
  color: #E57373;
  margin-right: 6rpx;
}

.char-count, .image-count {
  font-size: 24rpx;
  font-weight: normal;
  color: #A8A5A2;
}

/* 反馈类型 */
.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.type-item {
  padding: 18rpx 36rpx;
  background-color: #F8F6F3;
  color: #7A7673;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 36rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.type-item.active {
  background: linear-gradient(135deg, #FFE8E4 0%, #FFF5F0 100%);
  color: #FF8066;
  border-color: rgba(255, 128, 102, 0.3);
  transform: scale(1.02);
}

/* 输入区域 */
.textarea {
  width: 100%;
  height: 260rpx;
  padding: 28rpx;
  background-color: #F8F6F3;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #3D3A38;
  line-height: 1.6;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.textarea:focus {
  background-color: #FFFFFF;
  border-color: #FFAB91;
}

.input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  background-color: #F8F6F3;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #3D3A38;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.input:focus {
  background-color: #FFFFFF;
  border-color: #FFAB91;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
}

.delete-icon {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(61, 58, 56, 0.6);
  border-radius: 50%;
  padding: 10rpx;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  background-color: #F8F6F3;
  border-radius: 20rpx;
  border: 2rpx dashed #E0DDD8;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  transition: all 0.2s ease;
}

.add-image:active {
  background-color: #FFE8E4;
  border-color: #FFAB91;
}

.add-icon {
  font-size: 60rpx;
  color: #CCCCCC;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #A8A5A2;
  margin-top: 10rpx;
}

.upload-tip {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 提交按钮 */
.submit-section {
  padding: 36rpx 0;
}

.submit-btn {
  height: 104rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 52rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 128, 102, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(255, 128, 102, 0.25);
}

/* 提示 */
.tips-section {
  background: linear-gradient(135deg, #FFF9F0 0%, #FFE8DC 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 183, 77, 0.2);
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #F57C00;
  margin-bottom: 18rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #7A7673;
  display: block;
  line-height: 1.6;
}
