/* pages/order-confirm/index.wxss - 智伴家订单确认页柔和精致风格 */

.container {
  min-height: 100vh;
  background-color: #FFF9F5;
  padding: 28rpx;
  padding-bottom: 180rpx;
}

/* ==================== 陪伴师卡片 ==================== */

.teacher-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.teacher-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  margin-right: 28rpx;
  background-color: #FFE8E4;
  box-shadow: 0 4rpx 12rpx rgba(255, 128, 102, 0.15);
}

.teacher-info {
  flex: 1;
}

.teacher-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D3A38;
  display: block;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.teacher-title {
  font-size: 26rpx;
  color: #7A7673;
  margin-top: 6rpx;
  display: block;
}

.teacher-rating {
  font-size: 30rpx;
  color: #FFB74D;
  font-weight: 700;
}

/* ==================== 区块 ==================== */

.section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3A38;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #FF8066 0%, #FFAB91 100%);
  border-radius: 3rpx;
}

.add-btn {
  font-size: 26rpx;
  color: #FF8066;
  font-weight: 600;
}

/* ==================== 服务选择 ==================== */

.service-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.service-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  background-color: #F8F6F3;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.service-item.active {
  border-color: #FF8066;
  background: linear-gradient(135deg, #FFE8E4 0%, #FFF5F0 100%);
  transform: scale(1.01);
  box-shadow: 0 4rpx 16rpx rgba(255, 128, 102, 0.15);
}

.service-name {
  font-size: 30rpx;
  color: #3D3A38;
  font-weight: 500;
}

.service-price {
  font-size: 30rpx;
  color: #FF8066;
  font-weight: 700;
}

/* ==================== 孩子选择 ==================== */

.child-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.child-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  background-color: #F8F6F3;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.child-item.active {
  border-color: #2E7D6B;
  background: linear-gradient(135deg, #E0F2EE 0%, #F0FAF7 100%);
  transform: scale(1.01);
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 107, 0.12);
}

.child-info {
  flex: 1;
}

.child-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D3A38;
  display: block;
}

.child-detail {
  font-size: 26rpx;
  color: #7A7673;
  margin-top: 6rpx;
  display: block;
}

.check-icon {
  font-size: 36rpx;
  color: #2E7D6B;
  font-weight: 700;
}

.empty-child {
  text-align: center;
  padding: 36rpx;
  color: #A8A5A2;
  font-size: 28rpx;
}

/* ==================== 表单项 ==================== */

.form-list {
  display: flex;
  flex-direction: column;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F3F0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #7A7673;
}

.picker-value {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #3D3A38;
  font-weight: 500;
}

.arrow-icon {
  font-size: 36rpx;
  color: #CCCCCC;
  margin-left: 10rpx;
}

/* ==================== 地址/备注输入 ==================== */

.address-input, .remark-input {
  margin-top: 28rpx;
}

.textarea {
  width: 100%;
  height: 180rpx;
  padding: 28rpx;
  background-color: #F8F6F3;
  border-radius: 18rpx;
  font-size: 30rpx;
  color: #3D3A38;
  line-height: 1.6;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.textarea:focus {
  background-color: #FFFFFF;
  border-color: #FFAB91;
}

/* ==================== 优惠券 ==================== */

.coupon-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.coupon-label {
  font-size: 32rpx;
  color: #3D3A38;
  font-weight: 500;
}

.coupon-value {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #FF8066;
  font-weight: 600;
}

.no-coupon {
  color: #A8A5A2;
  font-weight: normal;
}

/* ==================== 价格明细 ==================== */

.price-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 56, 0.06);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
}

.price-label {
  font-size: 30rpx;
  color: #7A7673;
}

.price-value {
  font-size: 30rpx;
  color: #3D3A38;
}

.price-value.discount {
  color: #2E7D6B;
  font-weight: 600;
}

.price-row.total {
  margin-top: 20rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #F5F3F0;
}

.price-row.total .price-label {
  font-weight: 600;
  color: #3D3A38;
}

.price-value.final {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF8066;
}

/* ==================== 底部栏 ==================== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx 48rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -6rpx 24rpx rgba(61, 58, 56, 0.06);
}

.total-price {
  flex: 1;
}

.total-price .label {
  font-size: 28rpx;
  color: #7A7673;
}

.total-price .value {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF8066;
  font-family: 'DM Serif Display', serif;
}

.submit-btn {
  min-width: 300rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FF8066 0%, #FFAB91 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 128, 102, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.submit-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(255, 128, 102, 0.25);
}

/* ==================== 优惠券弹窗 ==================== */

.coupon-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(61, 58, 56, 0.6);
  z-index: 100;
}

.coupon-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  max-height: 70vh;
}

.coupon-picker.show {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx;
  border-bottom: 1rpx solid #F5F3F0;
}

.picker-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D3A38;
  font-family: 'DM Serif Display', 'Noto Serif SC', serif;
}

.close-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.4;
}

.coupon-list {
  padding: 28rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.coupon-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background-color: #F8F6F3;
  border-radius: 20rpx;
  margin-bottom: 18rpx;
  transition: all 0.2s ease;
}

.coupon-item:active {
  background-color: #FFE8E4;
}

.coupon-item.disabled {
  opacity: 0.5;
}

.coupon-amount {
  width: 140rpx;
  text-align: center;
  margin-right: 28rpx;
  border-right: 2rpx dashed #E8E5E2;
  padding-right: 28rpx;
}

.amount-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF8066;
  font-family: 'DM Serif Display', serif;
}

.coupon-info {
  flex: 1;
}

.coupon-name {
  font-size: 30rpx;
  color: #3D3A38;
  font-weight: 600;
  display: block;
}

.coupon-condition, .coupon-expire {
  font-size: 24rpx;
  color: #A8A5A2;
  margin-top: 6rpx;
  display: block;
}
