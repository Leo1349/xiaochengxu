/* pages/order-confirm/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 160rpx;
}

.section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.teacher-info {
  display: flex;
  align-items: center;
}

.teacher-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.teacher-detail {
  flex: 1;
}

.teacher-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.teacher-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.teacher-rating {
  display: flex;
  align-items: center;
}

.star {
  font-size: 24rpx;
}

.rating-num {
  font-size: 24rpx;
  color: #ff9500;
  margin-left: 8rpx;
}

.service-selector {
  display: flex;
  flex-direction: column;
}

.service-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.service-item.selected {
  background: rgba(74, 144, 217, 0.1);
  border-color: #4a90d9;
}

.service-name {
  font-size: 28rpx;
  color: #333;
}

.service-price {
  font-size: 28rpx;
  color: #ff9500;
  font-weight: bold;
}

.child-selector {
  display: flex;
  flex-direction: column;
}

.child-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.child-item.selected {
  background: rgba(74, 144, 217, 0.1);
  border-color: #4a90d9;
}

.child-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.child-info {
  flex: 1;
}

.child-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.child-grade {
  font-size: 24rpx;
  color: #999;
}

.add-child-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
}

.add-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.add-text {
  font-size: 28rpx;
  color: #666;
}

.time-picker {
  display: flex;
  flex-direction: column;
}

.picker-row {
  display: flex;
  margin-bottom: 20rpx;
}

.picker-item {
  flex: 1;
  margin-right: 20rpx;
}

.picker-item:last-child {
  margin-right: 0;
}

.picker-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #999;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

.hours-input {
  display: flex;
  align-items: center;
}

.hours-btn {
  width: 72rpx;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
}

.hours-value {
  width: 120rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.address-input {
  width: 100%;
  min-height: 120rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.remark-input {
  width: 100%;
  min-height: 160rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.price-info {
  flex: 1;
}

.price-label {
  font-size: 26rpx;
  color: #999;
}

.price-value {
  font-size: 40rpx;
  color: #ff9500;
  font-weight: bold;
}

.submit-btn {
  width: 280rpx;
  height: 88rpx;
  background: #4a90d9;
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 以下为与 pages/order-confirm/index.wxml 对齐的样式（覆盖/补齐）===== */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 160rpx;
}

.teacher-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.teacher-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #f2f3f5;
  margin-right: 16rpx;
}

.teacher-info {
  flex: 1;
  min-width: 0;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.teacher-title {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999999;
}

.teacher-rating {
  flex: none;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(74, 144, 217, 0.08);
  color: #4a90d9;
  font-size: 24rpx;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx;
  margin: 0 0 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 14rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.add-btn {
  font-size: 24rpx;
  color: #4a90d9;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.service-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 18rpx;
  border: 1rpx solid transparent;
}

.service-item.active {
  background: rgba(74, 144, 217, 0.08);
  border-color: rgba(74, 144, 217, 0.35);
}

.service-name {
  font-size: 26rpx;
  color: #333333;
}

.service-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #ff9500;
}

.child-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.child-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 18rpx;
  border: 1rpx solid transparent;
}

.child-item.active {
  background: rgba(74, 144, 217, 0.08);
  border-color: rgba(74, 144, 217, 0.35);
}

.child-info {
  flex: 1;
  min-width: 0;
}

.child-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #333333;
}

.child-detail {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

.check-icon {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: rgba(74, 144, 217, 0.12);
  color: #4a90d9;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-child {
  padding: 18rpx;
  font-size: 24rpx;
  color: #999999;
  background: #f2f3f5;
  border-radius: 12rpx;
}

.form-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx;
  background: #f2f3f5;
  border-radius: 12rpx;
}

.form-label {
  font-size: 24rpx;
  color: #666666;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #333333;
}

.arrow-icon {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.35);
  line-height: 1;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx;
  background: #f2f3f5;
  border-radius: 12rpx;
}

.coupon-label {
  font-size: 24rpx;
  color: #666666;
}

.coupon-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #333333;
}

.no-coupon {
  color: #999999;
}

.price-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.price-row.total {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  margin-top: 8rpx;
  padding-top: 16rpx;
}

.price-label {
  font-size: 24rpx;
  color: #666666;
}

.price-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
}

.price-value.discount {
  color: #ff4444;
}

.price-value.final {
  color: #ff9500;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.total-price {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-price .label {
  font-size: 24rpx;
  color: #666666;
}

.total-price .value {
  font-size: 34rpx;
  font-weight: 800;
  color: #ff9500;
}

.submit-btn {
  flex: none;
  min-width: 240rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #4a90d9;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 998;
}

.coupon-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  transform: translateY(105%);
  transition: transform 0.25s ease;
  z-index: 999;
}

.coupon-picker.show {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 18rpx 12rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.picker-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
}

.coupon-list {
  max-height: 60vh;
  overflow: auto;
  padding: 12rpx 18rpx 18rpx;
}

.coupon-item {
  background: #f2f3f5;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.coupon-item.disabled {
  opacity: 0.5;
}

.coupon-name {
  font-size: 26rpx;
  color: #333333;
}

.coupon-amount {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  background: rgba(255, 149, 0, 0.12);
  color: #ff9500;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.amount-value {
  font-size: 28rpx;
}

.coupon-info {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.coupon-condition,
.coupon-expire {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}
