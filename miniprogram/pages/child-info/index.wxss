/* pages/child-info/index.wxss */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.child-list {
  padding: 20rpx 30rpx;
}

.child-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.child-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  color: #fff;
}

.child-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 24rpx;
}

.child-basic {
  flex: 1;
}

.child-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.child-age {
  font-size: 26rpx;
  opacity: 0.9;
}

.edit-btn {
  font-size: 32rpx;
}

.child-content {
  padding: 24rpx 30rpx;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.child-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.tag-item {
  padding: 8rpx 20rpx;
  background: rgba(74, 144, 217, 0.1);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #4a90d9;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
}

.child-actions {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  border-right: 1rpx solid #f5f5f5;
}

.action-btn:last-child {
  border-right: none;
}

.action-btn.danger {
  color: #ff4444;
}

.add-child-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin: 20rpx 30rpx;
  border: 2rpx dashed #ddd;
}

.add-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.add-text {
  font-size: 30rpx;
  color: #666;
}

.form-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #ff4444;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.picker-placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

.gender-selector {
  display: flex;
}

.gender-item {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-right: 20rpx;
  border: 2rpx solid transparent;
}

.gender-item:last-child {
  margin-right: 0;
}

.gender-item.active {
  background: rgba(74, 144, 217, 0.1);
  border-color: #4a90d9;
}

.gender-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.gender-text {
  font-size: 26rpx;
  color: #333;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  padding: 30rpx;
  border-top: 1rpx solid #eee;
}

.cancel-btn {
  flex: 1;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.confirm-btn {
  flex: 1;
  height: 88rpx;
  background: #4a90d9;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ---- WXML ¶ÔÆë²¹¶¡£ºcontainer/page-header/child-info/picker-value µÈ ---- */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.page-header {
  padding: 26rpx 30rpx 10rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #777;
}

.child-list {
  padding: 16rpx 30rpx;
}

.child-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.name-row {
  display: flex;
  align-items: center;
}

.child-gender {
  margin-left: 14rpx;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.22);
}

.child-gender.male {
  background: rgba(255, 255, 255, 0.22);
}

.child-gender.female {
  background: rgba(255, 255, 255, 0.22);
}

.child-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.95;
}

.action-icon.delete {
  opacity: 0.9;
}

.child-info {
  padding: 22rpx 30rpx;
}

.add-btn-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx 30rpx;
  background: linear-gradient(
    to top,
    rgba(245, 245, 245, 1),
    rgba(245, 245, 245, 0)
  );
  box-sizing: border-box;
}

.add-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  margin-right: 10rpx;
}

.empty-state {
  padding: 90rpx 0;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 18rpx;
  opacity: 0.9;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #aaa;
}

.picker-value {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  font-size: 28rpx;
}

.arrow-icon {
  font-size: 30rpx;
  color: #bbb;
  line-height: 1;
}

.close-icon {
  width: 42rpx;
  height: 42rpx;
}
