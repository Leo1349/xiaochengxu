/* pages/child-info/index.wxss - TDesign 风格孩子信息页样式 (Hardcoded) */

.container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 列表容器 */
.child-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 孩子卡片 */
.child-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.child-card:active { transform: scale(0.99); }

.child-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #E6F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 40rpx;
  color: #3D7EFF;
  font-weight: 600;
}

.child-info {
  flex: 1;
}

.info-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.child-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 16rpx;
}

.child-gender {
  font-size: 24rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.child-gender.male {
  background-color: #E6F0FF;
  color: #3D7EFF;
}

.child-gender.female {
  background-color: #FFF0F6;
  color: #FF4D8F;
}

.info-detail {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
}

.edit-btn {
  padding: 16rpx;
}

.edit-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.4;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 40rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.add-btn {
  height: 88rpx;
  background: linear-gradient(135deg, #3D7EFF 0%, #0052D9 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(61, 126, 255, 0.3);
}

.add-btn:active { opacity: 0.9; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
